{
  "schema_version": "review_config_v1",
  "mode": "shadow",
  "validator_contract_version": "validator_response_v8",
  "response_correction": {"max_corrections_per_seat":1,"max_calls_per_candidate_version":3,"max_input_bytes":16000,"max_output_tokens":1536,"max_reserved_tokens_per_candidate_version":54000,"timeout_seconds":60,"max_initial_attempts_per_seat":2},
  "ontology_context": {"top_k_properties":8,"max_properties":24,"max_classes":64,"max_chars":32000},
  "mapping_preflight": {"enabled":true},
  "dispute_review": {"enabled":true},
  "semantic_clarification": {"enabled":true},
  "output_structure": {"capabilities_path":"config/review_output_capabilities.json"},
  "scope_policy": {
    "version": "knowledge_scope_v2",
    "task_goal": "收录可复用的一般领域知识与保留完整条件的知识；局部约定、推导步骤和教学示例保留来源记录，不进入主图。",
    "decision_authority": "program",
    "excluded_scopes": [
      "local_definition",
      "derivation",
      "example"
    ],
    "unresolved_action": "scope_review",
    "categories": {
      "general": {
        "label": "一般知识",
        "boundary": "在领域内可复用的事实、规律或概念定义。标准术语的通用定义归此类；不能仅因原文出现‘定义’就判为局部约定。"
      },
      "conditional": {
        "label": "条件性知识",
        "boundary": "在明确条件下可复用的领域事实；必须保留条件、频率、否定和模态。不能把‘在条件下成立’等同于局部符号约定。"
      },
      "local_definition": {
        "label": "局部定义或符号约定",
        "boundary": "仅在当前章节、推导或作者语境中约定的符号、命名和临时定义；不能直接推广为领域通用事实。"
      },
      "derivation": {
        "label": "推导步骤",
        "boundary": "为获得结论而采用的中间变形或证明过程。独立成立、可复用的最终定理按一般或条件性知识判断。"
      },
      "example": {
        "label": "教学示例",
        "boundary": "仅为演示方法而设定的具体对象、数值或情形；示例之外被明确支持的一般规律可单独审核。"
      },
      "unresolved": {
        "label": "类别待确认",
        "boundary": "上下文不足、类别分歧或有效审核席位不足时保留待确认，不由模型自行决定收录或排除。"
      }
    }
  },
  "local_operator": "local_operator",
  "database_path": "runs/v3/review.sqlite3",
  "ontology_path": "ontology/ontology.json",
  "planner": {
    "enabled": true,
    "strategy": "llm_react",
    "family_env": "KG_PLANNER_FAMILY",
    "fallback": "deterministic",
    "failure_policy": "bounded_minimum_v1",
    "max_output_tokens": 1024,
    "max_invalid_steps": 2,
    "max_repeated_actions": 2,
    "allowed_tools": ["inspect_context", "search_evidence", "inspect_ontology", "lookup_review_memory", "run_validation", "recover_validation", "propose_revision", "review_revision", "apply_reviewed_revision", "request_ontology_extension", "get_ontology_extension_status", "finish_review"],
    "model_env": "KG_PLANNER_MODEL",
    "api_key_env": "KG_PLANNER_API_KEY",
    "base_url_env": "KG_PLANNER_BASE_URL"
  },
  "ontology_extension": {"enabled": true, "strategy": "llm_react", "auto_publish_enabled": false, "require_reasoner": false,
    "budget": {"max_planner_steps": 14, "max_tool_calls": 18, "max_validation_rounds": 2, "max_llm_calls_per_candidate": 40, "total_timeout_seconds": 360}},
  "case_budget": {"llm_calls": 96, "tokens": 240000, "tool_calls": 64, "extension_requests": 1, "rebinds": 2},
  "validators": [
    {"id": "judge_a", "model_env": "KG_JUDGE_A_MODEL", "family_env": "KG_JUDGE_A_FAMILY", "api_key_env": "KG_JUDGE_A_API_KEY", "base_url_env": "KG_JUDGE_A_BASE_URL", "stream_responses": true},
    {"id": "judge_b", "model_env": "KG_JUDGE_B_MODEL", "family_env": "KG_JUDGE_B_FAMILY", "api_key_env": "KG_JUDGE_B_API_KEY", "base_url_env": "KG_JUDGE_B_BASE_URL"},
    {"id": "judge_c", "model_env": "KG_JUDGE_C_MODEL", "family_env": "KG_JUDGE_C_FAMILY", "api_key_env": "KG_JUDGE_C_API_KEY", "base_url_env": "KG_JUDGE_C_BASE_URL"}
  ],
  "consensus": {"version": "committee_qwen_gemma_deepseek_v1", "committee_size": 3, "required_votes": 3, "minimum_distinct_families": 3, "weighted_quorum_enabled": false, "max_rounds": 2},
  "budget": {"max_planner_steps": 6, "max_validation_rounds": 2, "max_tool_calls": 8, "max_llm_calls_per_candidate": 24, "max_total_tokens": 64000, "max_evidence_items": 12, "max_evidence_chars": 12000, "per_call_timeout_seconds": 45, "total_timeout_seconds": 240, "max_retries_per_request": 1, "max_parallel_validators": 3, "max_parallel_candidates": 2},
  "calibration": {"enabled": true, "feature_schema_version": "review_features_v3", "model_path": null, "policy_path": null, "target_precision": 0.95, "min_policy_selected": 100},
  "routing": {"auto_accept_enabled": false, "semantic_auto_reject_enabled": false, "random_audit_fraction": 0.05},
  "memory": {"enabled": true, "max_positive_cases": 3, "max_negative_cases": 3, "snapshot_policy": "freeze_per_audit"},
  "neo4j": {"auto_import_enabled": false, "require_current_decision": true}
}
