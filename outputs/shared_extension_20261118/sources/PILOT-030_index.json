        },
        {
          "sentence_id": "sentence_78285c5540857dfb05cb",
          "document_start": 627,
          "document_end": 629,
          "text": "$$",
          "section_id": "section_2c8bfa6b6a02",
          "start": 627,
          "end": 629,
          "chunk_start": 627,
          "chunk_end": 629,
          "sentence_document_start": 627,
          "sentence_document_end": 629,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2ebcf2a5bef0ba2fead8",
          "document_start": 630,
          "document_end": 725,
          "text": "h _ {1} = h _ {0 1} <   h _ {0 2} = h _ {2} + \\frac {1}{2} u _ {\\mathrm {P}} ^ {2} \\tag {2.172}",
          "section_id": "section_2c8bfa6b6a02",
          "start": 630,
          "end": 725,
          "chunk_start": 630,
          "chunk_end": 725,
          "sentence_document_start": 630,
