        },
        {
          "sentence_id": "sentence_b4bbed4614c349aa00d9",
          "document_start": 2413,
          "document_end": 2517,
          "text": "Now that we have the governing equations, we shall examine the behavior of a shock wave in a shock tube.",
          "section_id": "section_2c8bfa6b6a02",
          "start": 2413,
          "end": 2517,
          "chunk_start": 2413,
          "chunk_end": 2517,
          "sentence_document_start": 2413,
          "sentence_document_end": 2517,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_0bf25dc6808f55e16f95",
          "document_start": 2518,
          "document_end": 2587,
          "text": "A shock tube is a device as depicted in Figure 2.28 that contains two",
          "section_id": "section_2c8bfa6b6a02",
          "start": 2518,
          "end": 2587,
          "chunk_start": 2518,
          "chunk_end": 2587,
          "sentence_document_start": 2518,
          "sentence_document_end": 2587,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_777f208a307d9fc14c99",
          "document_start": 2589,
          "document_end": 2609,
          "text": "[Source paragraph 6;",
          "section_id": "section_2c8bfa6b6a02",
