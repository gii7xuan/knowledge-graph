        },
        {
          "sentence_id": "sentence_0846af1690aa4a04e6d8",
          "document_start": 726,
          "document_end": 728,
          "text": "$$",
          "section_id": "section_2c8bfa6b6a02",
          "start": 726,
          "end": 728,
          "chunk_start": 726,
          "chunk_end": 728,
          "sentence_document_start": 726,
          "sentence_document_end": 728,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f9a1b04ba168c8cf7905",
          "document_start": 730,
          "document_end": 750,
          "text": "[Source paragraph 3;",
          "section_id": "section_2c8bfa6b6a02",
          "start": 730,
          "end": 750,
          "chunk_start": 730,
          "chunk_end": 750,
          "sentence_document_start": 730,
