          "sentence_document_start": 80,
          "sentence_document_end": 112,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_92ec0b5151235c1dbcdb",
          "document_start": 114,
          "document_end": 262,
          "text": "The real power of these equations lies in the fact that with just the strength of the shock known, we can determine all the other items of interest.",
          "section_id": "section_2c8bfa6b6a02",
          "start": 114,
          "end": 262,
          "chunk_start": 114,
          "chunk_end": 262,
          "sentence_document_start": 114,
          "sentence_document_end": 262,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_3ad7ed92cead8489bc11",
          "document_start": 263,
          "document_end": 458,
          "text": "In the aforementioned equations, we have seen that given the pressure ratio (i.e., the strength) of the shock, we know the temperature behind the wave and the increase in density across the wave.",
          "section_id": "section_2c8bfa6b6a02",
          "start": 263,
          "end": 458,
          "chunk_start": 263,
          "chunk_end": 458,
          "sentence_document_start": 263,
          "sentence_document_end": 458,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_69d1178e075e4fcde7a3",
          "document_start": 459,
          "document_end": 549,
          "text": "We can also determine the wave speed  $U$  and induced velocity  $u_{\\mathrm{p}}$  through",
          "section_id": "section_2c8bfa6b6a02",
          "start": 459,
          "end": 549,
          "chunk_start": 459,
          "chunk_end": 549,
          "sentence_document_start": 459,
          "sentence_document_end": 549,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_07407c18c064947c7740",
          "document_start": 551,
          "document_end": 571,
          "text": "[Source paragraph 2;",
          "section_id": "section_2c8bfa6b6a02",
          "start": 551,
          "end": 571,
          "chunk_start": 551,
          "chunk_end": 571,
          "sentence_document_start": 551,
          "sentence_document_end": 571,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_07a73dca4ae9e2bcffbc",
          "document_start": 572,
          "document_end": 592,
          "text": "2.7 Fluid Mechanics;",
          "section_id": "section_2c8bfa6b6a02",
          "start": 572,
          "end": 592,
          "chunk_start": 572,
          "chunk_end": 592,
          "sentence_document_start": 572,
