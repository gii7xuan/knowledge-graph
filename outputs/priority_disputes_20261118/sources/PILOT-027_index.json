        {
          "sentence_id": "sentence_5f9d48d9e32f6ba9a6f4",
          "document_start": 1189,
          "document_end": 1215,
          "text": "实际流体由于存在黏性，在流动会有机械能向热能的转换。",
          "section_id": "section_671f4da228e0",
          "start": 1189,
