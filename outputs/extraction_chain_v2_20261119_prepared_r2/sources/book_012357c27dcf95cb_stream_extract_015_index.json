    },
    {
      "sentence_id": "sentence_423be5dc49c4932835db",
      "document_start": 1057,
      "document_end": 1087,
      "text": "一部摄像机获得的图像序列，可以识别出两个线位移和一个角位移。",
      "section_id": "section_68bab1a46400"
    },
    {
      "sentence_id": "sentence_f316bb89d72e4e39cb5f",
      "document_start": 1089,
      "document_end": 1109,
      "text": "[Source paragraph 7;",
      "section_id": "section_68bab1a46400"
    },
    {
