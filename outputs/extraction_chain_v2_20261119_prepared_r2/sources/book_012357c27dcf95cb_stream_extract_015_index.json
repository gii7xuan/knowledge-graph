    {
      "sentence_id": "sentence_2acd4f446980af4bb6b4",
      "document_start": 1374,
      "document_end": 1408,
      "text": "压阻式加速度传感器利用半导体压敏电阻材料作为敏感元件测量振动加速度。",
      "section_id": "section_68bab1a46400"
    },
    {
