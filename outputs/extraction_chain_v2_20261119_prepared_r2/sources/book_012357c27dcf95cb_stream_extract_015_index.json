          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_bd470cb93b6803460667",
          "document_start": 1157,
          "document_end": 1226,
          "text": "压电式加速度传感器结构简单、牢固、体积小、质量轻，频率响应范围宽，动态范围大，性能稳定，输出线性好，使用温度范围以及抗外磁场干扰能力较强。",
          "section_id": "section_68bab1a46400",
          "start": 1157,
          "end": 1226,
          "chunk_start": 1157,
          "chunk_end": 1226,
          "sentence_document_start": 1157,
          "sentence_document_end": 1226,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_3c178d81f871c2a4eddf",
          "document_start": 1226,
          "document_end": 1268,
          "text": "压电式加速度传感器的结构按压电晶体的工作方式可分为三种形式：压缩型、弯曲型和剪切型。",
          "section_id": "section_68bab1a46400",
          "start": 1226,
          "end": 1268,
          "chunk_start": 1226,
          "chunk_end": 1268,
          "sentence_document_start": 1226,
          "sentence_document_end": 1268,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_486a2becb147aa9f2234",
          "document_start": 1268,
          "document_end": 1304,
          "text": "其中压缩型又分为周边压缩式、中心压缩式、倒装中心压缩式和基座隔离压缩式。",
          "section_id": "section_68bab1a46400",
          "start": 1268,
          "end": 1304,
          "chunk_start": 1268,
          "chunk_end": 1304,
          "sentence_document_start": 1268,
          "sentence_document_end": 1304,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_aad84c2eb8f52c00cccd",
          "document_start": 1306,
          "document_end": 1326,
          "text": "[Source paragraph 8;",
          "section_id": "section_68bab1a46400",
          "start": 1306,
          "end": 1326,
          "chunk_start": 1306,
          "chunk_end": 1326,
          "sentence_document_start": 1306,
          "sentence_document_end": 1326,
          "sentence_complete": true
        },
