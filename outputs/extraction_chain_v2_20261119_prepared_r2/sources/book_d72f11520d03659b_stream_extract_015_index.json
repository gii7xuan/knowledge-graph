      "document_start": 59,
      "document_end": 81,
      "text": "# （一）后坐加速开门阶段自动机动力学模型;",
      "section_id": "section_a58411016edc"
    },
    {
      "sentence_id": "sentence_b0aa8e5d8ed1d0c516e6",
