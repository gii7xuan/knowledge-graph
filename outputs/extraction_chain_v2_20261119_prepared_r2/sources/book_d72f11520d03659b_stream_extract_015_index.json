          "start": 243,
          "end": 261,
          "chunk_start": 243,
          "chunk_end": 261,
          "sentence_document_start": 243,
          "sentence_document_end": 261,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2a2c1edf0918774c1b03",
          "document_start": 263,
          "document_end": 283,
          "text": "[Source paragraph 2;",
          "section_id": "section_a58411016edc",
          "start": 263,
          "end": 283,
          "chunk_start": 263,
          "chunk_end": 283,
          "sentence_document_start": 263,
          "sentence_document_end": 283,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_a509299ecf2c1e8b2e8d",
          "document_start": 284,
          "document_end": 308,
          "text": "# （二）身管组和门座组相互独立运动动力学模型;",
          "section_id": "section_a58411016edc",
          "start": 284,
          "end": 308,
          "chunk_start": 284,
          "chunk_end": 308,
          "sentence_document_start": 284,
          "sentence_document_end": 308,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_aec00b762806d36e1807",
          "document_start": 309,
          "document_end": 341,
          "text": "intervening text may be omitted]",
          "section_id": "section_a58411016edc",
          "start": 309,
          "end": 341,
          "chunk_start": 309,
          "chunk_end": 341,
          "sentence_document_start": 309,
          "sentence_document_end": 341,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b3a229ecd9743c05a629",
          "document_start": 343,
          "document_end": 410,
          "text": "身管组和闩座组脱离加速臂的作用后，各自成为独立变量在整体缓冲器作用下独立运动，共同通过气腔耦合，此阶段键合空间模型如图5.4.9所示。",
          "section_id": "section_a58411016edc",
          "start": 343,
          "end": 410,
          "chunk_start": 343,
          "chunk_end": 410,
          "sentence_document_start": 343,
          "sentence_document_end": 410,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_73b23090f3ad8a6990c1",
          "document_start": 412,
          "document_end": 432,
          "text": "[Source paragraph 3;",
          "section_id": "section_a58411016edc",
          "start": 412,
          "end": 432,
          "chunk_start": 412,
          "chunk_end": 432,
          "sentence_document_start": 412,
          "sentence_document_end": 432,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_7ac0ca051fdb07acc344",
          "document_start": 433,
          "document_end": 454,
          "text": "# 6.1 自动机和供弹机多体动力学模型;",
          "section_id": "section_a58411016edc",
          "start": 433,
          "end": 454,
          "chunk_start": 433,
          "chunk_end": 454,
          "sentence_document_start": 433,
          "sentence_document_end": 454,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_633a3ee3e50252db2ca0",
          "document_start": 455,
          "document_end": 487,
          "text": "intervening text may be omitted]",
          "section_id": "section_a58411016edc",
          "start": 455,
          "end": 487,
          "chunk_start": 455,
          "chunk_end": 487,
          "sentence_document_start": 455,
          "sentence_document_end": 487,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_580766d65d3c65000fec",
          "document_start": 489,
          "document_end": 539,
          "text": "虚拟样机技术的核心理论是多体系统动力学，多体系统动力学是由多刚体系统动力学与多柔体系统动力学组成的。",
          "section_id": "section_a58411016edc",
          "start": 489,
          "end": 539,
          "chunk_start": 489,
          "chunk_end": 539,
          "sentence_document_start": 489,
          "sentence_document_end": 539,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_05051e14fff4fb7d83ee",
          "document_start": 539,
          "document_end": 611,
          "text": "多刚体系统动力学的研究对象是由任意有限个刚体组成的系统，刚体之间以某种形式的约束连接，这些约束可以是理想完整约束、非完整约束、定常或非定常约束。",
          "section_id": "section_a58411016edc",
          "start": 539,
          "end": 611,
          "chunk_start": 539,
          "chunk_end": 611,
          "sentence_document_start": 539,
          "sentence_document_end": 611,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5cafa59a826b765685e2",
          "document_start": 611,
          "document_end": 656,
          "text": "研究这些系统的动力学需要建立非线性运动方程、能量表达式、运动学表达式以及其他一些量的公式。",
          "section_id": "section_a58411016edc",
          "start": 611,
          "end": 656,
          "chunk_start": 611,
          "chunk_end": 656,
          "sentence_document_start": 611,
          "sentence_document_end": 656,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_a5f2bf37a4c73f292d54",
          "document_start": 656,
          "document_end": 684,
          "text": "多柔体系统动力学的研究对象是由大量刚体和柔体组成的系统。",
          "section_id": "section_a58411016edc",
          "start": 656,
          "end": 684,
          "chunk_start": 656,
          "chunk_end": 684,
          "sentence_document_start": 656,
          "sentence_document_end": 684,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b3f98c6a222b565f7e30",
          "document_start": 686,
          "document_end": 706,
          "text": "[Source paragraph 4;",
          "section_id": "section_a58411016edc",
          "start": 686,
          "end": 706,
          "chunk_start": 686,
          "chunk_end": 706,
          "sentence_document_start": 686,
          "sentence_document_end": 706,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_09a06c0efc0578bf1afe",
          "document_start": 707,
          "document_end": 728,
          "text": "# 6.1 自动机和供弹机多体动力学模型;",
          "section_id": "section_a58411016edc",
          "start": 707,
          "end": 728,
          "chunk_start": 707,
          "chunk_end": 728,
          "sentence_document_start": 707,
          "sentence_document_end": 728,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_07a939bf195c7fd9c0ea",
          "document_start": 729,
          "document_end": 761,
          "text": "intervening text may be omitted]",
          "section_id": "section_a58411016edc",
          "start": 729,
          "end": 761,
          "chunk_start": 729,
          "chunk_end": 761,
          "sentence_document_start": 729,
          "sentence_document_end": 761,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2df9714b2aa81dd9e48b",
          "document_start": 763,
          "document_end": 807,
          "text": "多刚体系统动力学主要解决多个刚体组成的系统动力学问题，各个构件之间可以有较大的相对运动。",
          "section_id": "section_a58411016edc",
          "start": 763,
          "end": 807,
          "chunk_start": 763,
          "chunk_end": 807,
          "sentence_document_start": 763,
          "sentence_document_end": 807,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_29ff9b39176675dc57eb",
          "document_start": 807,
          "document_end": 834,
          "text": "多柔体系统动力学可以看作是多刚体系统动力学的自然延伸。",
          "section_id": "section_a58411016edc",
          "start": 807,
          "end": 834,
          "chunk_start": 807,
          "chunk_end": 834,
          "sentence_document_start": 807,
          "sentence_document_end": 834,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_50ad86f759e84e6fb9a0",
          "document_start": 834,
          "document_end": 915,
          "text": "根据多柔体系统组成特点，一般以多刚体系统动力学的研究为基础，对系统中柔性体进行不同的处理，在机械系统中常用的处理方法有离散法、模态分析法、形函数法和有限单元法等。",
          "section_id": "section_a58411016edc",
          "start": 834,
          "end": 915,
          "chunk_start": 834,
          "chunk_end": 915,
          "sentence_document_start": 834,
          "sentence_document_end": 915,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_4b43e0084870d5827d68",
          "document_start": 915,
          "document_end": 952,
          "text": "将柔性体的分析结果与多刚体系统的研究方法相结合，最终得到系统的动力学方程。",
          "section_id": "section_a58411016edc",
          "start": 915,
          "end": 952,
          "chunk_start": 915,
          "chunk_end": 952,
          "sentence_document_start": 915,
          "sentence_document_end": 952,
          "sentence_complete": true
        }
      ],
