          "sentence_document_end": 792,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_086c18c31c12bf2ea6ec",
          "document_start": 792,
          "document_end": 810,
          "text": "因此闭锁齿承受切向载荷时，会引起闩体",
          "section_id": "section_53c62530f0d4",
          "start": 792,
          "end": 810,
          "chunk_start": 792,
          "chunk_end": 810,
          "sentence_document_start": 792,
          "sentence_document_end": 810,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b493bef21fea779b5b23",
          "document_start": 812,
          "document_end": 832,
          "text": "[Source paragraph 6;",
          "section_id": "section_53c62530f0d4",
          "start": 812,
          "end": 832,
          "chunk_start": 812,
          "chunk_end": 832,
          "sentence_document_start": 812,
          "sentence_document_end": 832,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_576be4613aa5cd552b58",
          "document_start": 833,
          "document_end": 861,
          "text": "# 3.3.3 切向和径向载荷共同作用时闭锁齿应力分析;",
          "section_id": "section_53c62530f0d4",
          "start": 833,
          "end": 861,
          "chunk_start": 833,
          "chunk_end": 861,
          "sentence_document_start": 833,
          "sentence_document_end": 861,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b58b7a352ab09cd03516",
          "document_start": 862,
          "document_end": 894,
          "text": "intervening text may be omitted]",
          "section_id": "section_53c62530f0d4",
          "start": 862,
          "end": 894,
          "chunk_start": 862,
          "chunk_end": 894,
          "sentence_document_start": 862,
          "sentence_document_end": 894,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5fc23d20cdd9cfcf19f2",
          "document_start": 896,
          "document_end": 965,
          "text": "荷共同作用时，如图3.3.12所示，按以上分析的最大径向力加载，对不同切向载荷下闩体闭锁齿应力进行分析，应力分析结果如图3.3.13所示。",
          "section_id": "section_53c62530f0d4",
          "start": 896,
          "end": 965,
          "chunk_start": 896,
          "chunk_end": 965,
          "sentence_document_start": 896,
          "sentence_document_end": 965,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5ff88a6b6ae46139c9d9",
          "document_start": 967,
          "document_end": 987,
          "text": "[Source paragraph 7;",
          "section_id": "section_53c62530f0d4",
          "start": 967,
          "end": 987,
          "chunk_start": 967,
          "chunk_end": 987,
          "sentence_document_start": 967,
          "sentence_document_end": 987,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f65f006662c1c28ed919",
          "document_start": 988,
          "document_end": 1016,
          "text": "# 3.3.3 切向和径向载荷共同作用时闭锁齿应力分析;",
          "section_id": "section_53c62530f0d4",
          "start": 988,
          "end": 1016,
          "chunk_start": 988,
          "chunk_end": 1016,
          "sentence_document_start": 988,
          "sentence_document_end": 1016,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_8ff33f5bf7a3c05175d3",
          "document_start": 1017,
          "document_end": 1049,
          "text": "intervening text may be omitted]",
          "section_id": "section_53c62530f0d4",
          "start": 1017,
          "end": 1049,
          "chunk_start": 1017,
          "chunk_end": 1049,
          "sentence_document_start": 1017,
          "sentence_document_end": 1049,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e6fda12ff510b2936934",
          "document_start": 1051,
          "document_end": 1128,
          "text": "分析结果表明，闭锁齿在同时承受径向和切向载荷时会在两侧面交汇处的齿根部形成较大的应力（与裂纹产生处接近），不同切向载荷时闭锁齿最大应力结果见表3.3.2。",
          "section_id": "section_53c62530f0d4",
          "start": 1051,
          "end": 1128,
          "chunk_start": 1051,
          "chunk_end": 1128,
          "sentence_document_start": 1051,
          "sentence_document_end": 1128,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_4286824d586a537d1ef2",
          "document_start": 1130,
          "document_end": 1150,
          "text": "[Source paragraph 8;",
          "section_id": "section_53c62530f0d4",
          "start": 1130,
          "end": 1150,
          "chunk_start": 1130,
          "chunk_end": 1150,
          "sentence_document_start": 1130,
          "sentence_document_end": 1150,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_fb6595fc7bb68dab5f66",
          "document_start": 1151,
          "document_end": 1164,
          "text": "# 3.3.4 碰撞分析;",
          "section_id": "section_53c62530f0d4",
          "start": 1151,
          "end": 1164,
          "chunk_start": 1151,
          "chunk_end": 1164,
          "sentence_document_start": 1151,
          "sentence_document_end": 1164,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e50cdd643abd8c9c166a",
          "document_start": 1165,
          "document_end": 1197,
          "text": "intervening text may be omitted]",
          "section_id": "section_53c62530f0d4",
          "start": 1165,
          "end": 1197,
          "chunk_start": 1165,
          "chunk_end": 1197,
          "sentence_document_start": 1165,
          "sentence_document_end": 1197,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_6ad471ee7fcdc56b0f7b",
          "document_start": 1199,
          "document_end": 1247,
          "text": "通过上述分析可以明确，造成小齿断裂的主因是开闭锁过程中碰撞产生的惯性力，断裂的性质应是疲劳断裂。",
          "section_id": "section_53c62530f0d4",
          "start": 1199,
          "end": 1247,
          "chunk_start": 1199,
          "chunk_end": 1247,
          "sentence_document_start": 1199,
          "sentence_document_end": 1247,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e09ba0e9a5596ccd7c1c",
          "document_start": 1247,
          "document_end": 1268,
          "text": "通过对实际断裂件的断口分析也验证了这一点。",
          "section_id": "section_53c62530f0d4",
          "start": 1247,
          "end": 1268,
          "chunk_start": 1247,
          "chunk_end": 1268,
          "sentence_document_start": 1247,
          "sentence_document_end": 1268,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_38dbcfafbd175d22be06",
          "document_start": 1270,
          "document_end": 1290,
          "text": "[Source paragraph 9;",
          "section_id": "section_53c62530f0d4",
          "start": 1270,
          "end": 1290,
          "chunk_start": 1270,
          "chunk_end": 1290,
          "sentence_document_start": 1270,
          "sentence_document_end": 1290,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9561ececc9c84141601d",
          "document_start": 1291,
          "document_end": 1309,
          "text": "# 一、加载碰撞惯性力时的应力云图;",
          "section_id": "section_53c62530f0d4",
          "start": 1291,
          "end": 1309,
          "chunk_start": 1291,
          "chunk_end": 1309,
          "sentence_document_start": 1291,
          "sentence_document_end": 1309,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_d06de5d8b19fb812f859",
          "document_start": 1310,
          "document_end": 1342,
          "text": "intervening text may be omitted]",
          "section_id": "section_53c62530f0d4",
          "start": 1310,
          "end": 1342,
          "chunk_start": 1310,
          "chunk_end": 1342,
          "sentence_document_start": 1310,
          "sentence_document_end": 1342,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_da4284255c288be83a46",
          "document_start": 1344,
          "document_end": 1404,
          "text": "在开闭锁过程中，碰撞并不是发生在小齿位置，而是发生在离小齿较远的门体后部，在这种情况下，小齿受力只可能是碰撞引起的惯性。",
          "section_id": "section_53c62530f0d4",
          "start": 1344,
          "end": 1404,
          "chunk_start": 1344,
          "chunk_end": 1404,
          "sentence_document_start": 1344,
          "sentence_document_end": 1404,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_3422fcfd50fe2b444fa8",
          "document_start": 1404,
          "document_end": 1465,
          "text": "为此通过前面的虚拟样机分析后，确定了惯性力的特性和大量，得到应力云图结果如图3.3.18所示，图3.3.19为其局部放大。",
          "section_id": "section_53c62530f0d4",
          "start": 1404,
          "end": 1465,
          "chunk_start": 1404,
          "chunk_end": 1465,
          "sentence_document_start": 1404,
          "sentence_document_end": 1465,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e409a59a24ff7d19e3ce",
          "document_start": 1467,
          "document_end": 1488,
          "text": "[Source paragraph 10;",
          "section_id": "section_53c62530f0d4",
          "start": 1467,
          "end": 1488,
          "chunk_start": 1467,
          "chunk_end": 1488,
          "sentence_document_start": 1467,
          "sentence_document_end": 1488,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_6d6ddc23ed073df91012",
          "document_start": 1489,
          "document_end": 1509,
          "text": "# 三、碰撞惯性力作用下的疲劳寿命估计;",
          "section_id": "section_53c62530f0d4",
          "start": 1489,
          "end": 1509,
          "chunk_start": 1489,
          "chunk_end": 1509,
          "sentence_document_start": 1489,
          "sentence_document_end": 1509,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_39360c56bbd12c671ba8",
          "document_start": 1510,
          "document_end": 1542,
          "text": "intervening text may be omitted]",
          "section_id": "section_53c62530f0d4",
          "start": 1510,
          "end": 1542,
          "chunk_start": 1510,
          "chunk_end": 1542,
          "sentence_document_start": 1510,
          "sentence_document_end": 1542,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_214bed8c16263572c9bf",
          "document_start": 1544,
          "document_end": 1596,
          "text": "通过图3.3.22和图3.3.23可以看出，受开闭锁碰撞惯性力作用，小齿根部的疲劳寿命最低，在百次级别。",
          "section_id": "section_53c62530f0d4",
          "start": 1544,
          "end": 1596,
          "chunk_start": 1544,
          "chunk_end": 1596,
          "sentence_document_start": 1544,
          "sentence_document_end": 1596,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_8006f64dae73cfa81134",
          "document_start": 1596,
          "document_end": 1667,
          "text": "计算是按理想的情况，但在实际中，由于其形状特殊，现有工艺对小齿根的表面强化非常困难，若表面有划痕和缺陷，其疲劳寿命还会低，这也与试验现象一致。",
          "section_id": "section_53c62530f0d4",
          "start": 1596,
          "end": 1667,
          "chunk_start": 1596,
          "chunk_end": 1667,
          "sentence_document_start": 1596,
          "sentence_document_end": 1667,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_4b6364f342e21aab947f",
          "document_start": 1667,
          "document_end": 1690,
          "text": "上述分析，也为后续的改进设计和工艺提供了参考。",
          "section_id": "section_53c62530f0d4",
          "start": 1667,
          "end": 1690,
          "chunk_start": 1667,
          "chunk_end": 1690,
          "sentence_document_start": 1667,
          "sentence_document_end": 1690,
          "sentence_complete": true
        }
      ],
