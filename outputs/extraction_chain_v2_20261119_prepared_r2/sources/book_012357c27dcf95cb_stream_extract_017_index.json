          "chunk_start": 642,
          "chunk_end": 682,
          "sentence_document_start": 642,
          "sentence_document_end": 682,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c293c4e7f5b89dfd363c",
          "document_start": 682,
          "document_end": 712,
          "text": "因此，分析对象及简化模型这一步至关重要，直接影响结果可靠性。",
          "section_id": "section_689c24a9abcf",
          "start": 682,
          "end": 712,
          "chunk_start": 682,
          "chunk_end": 712,
          "sentence_document_start": 682,
