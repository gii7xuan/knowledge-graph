      "text": "[Source paragraph 4;",
      "section_id": "section_af3c5259ddf4"
    },
    {
      "sentence_id": "sentence_6a5403a1abc04110a822",
      "document_start": 878,
      "document_end": 890,
      "text": "# 二、摩阻元件的定义;",
