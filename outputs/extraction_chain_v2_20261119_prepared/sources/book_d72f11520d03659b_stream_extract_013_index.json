          "chunk_start": 38,
          "chunk_end": 58,
          "sentence_document_start": 38,
          "sentence_document_end": 58,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_46cf56cd729abe52a283",
          "document_start": 59,
          "document_end": 80,
          "text": "# 5.2.2 键合图模型因果关系的确定;",
          "section_id": "section_cad95f4364d5",
          "start": 59,
          "end": 80,
          "chunk_start": 59,
          "chunk_end": 80,
          "sentence_document_start": 59,
          "sentence_document_end": 80,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b26316dae9ef1907ed0c",
          "document_start": 81,
          "document_end": 113,
          "text": "intervening text may be omitted]",
          "section_id": "section_cad95f4364d5",
          "start": 81,
          "end": 113,
          "chunk_start": 81,
          "chunk_end": 113,
          "sentence_document_start": 81,
          "sentence_document_end": 113,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_375f474d385acb240fbc",
          "document_start": 115,
          "document_end": 210,
          "text": "对于二通口元件TF和GY来讲，由元件特性所确定的因果关系分别具有两种情况，因此出现在系统模型中的TF和GY元件其因果关系必须是两种情况中的一种才能保证该二通口元件的定义在系统模型中的正确性。",
          "section_id": "section_cad95f4364d5",
          "start": 115,
          "end": 210,
          "chunk_start": 115,
          "chunk_end": 210,
          "sentence_document_start": 115,
          "sentence_document_end": 210,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c675f83c21afb024ff76",
          "document_start": 210,
          "document_end": 250,
          "text": "同样对于出现在系统模型中的0结和1结的因果关系也应该满足其定义所要求的因果关系。",
          "section_id": "section_cad95f4364d5",
          "start": 210,
          "end": 250,
          "chunk_start": 210,
          "chunk_end": 250,
          "sentence_document_start": 210,
          "sentence_document_end": 250,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_61089bfb4708aceddd2b",
          "document_start": 250,
          "document_end": 366,
          "text": "推而广之，对于任何一个键合图的模型来讲，构成模型的所有元件的因果关系都必须满足键图理论关于元件本身定义所要求的因果关系的种种要求，只要有任何一处不满足，都说明所得到的增广后的系统模型不正确，需要对建模的过程和模型增广的过程进行检查。",
          "section_id": "section_cad95f4364d5",
          "start": 250,
          "end": 366,
          "chunk_start": 250,
          "chunk_end": 366,
          "sentence_document_start": 250,
          "sentence_document_end": 366,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_38bfc647a991b10492bb",
          "document_start": 366,
          "document_end": 414,
          "text": "从这个意义上讲，一个系统的键合图模型的因果关系能否正确的标识，是判定该模型正确性的一个必要条件。",
          "section_id": "section_cad95f4364d5",
          "start": 366,
          "end": 414,
          "chunk_start": 366,
          "chunk_end": 414,
          "sentence_document_start": 366,
          "sentence_document_end": 414,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c6a77e8a5beb7d3c3a02",
          "document_start": 414,
          "document_end": 453,
          "text": "需要说明的是，对于同一个键合图模型来讲，其可正确标识出的因果关系往往不只一种。",
          "section_id": "section_cad95f4364d5",
          "start": 414,
          "end": 453,
          "chunk_start": 414,
          "chunk_end": 453,
          "sentence_document_start": 414,
          "sentence_document_end": 453,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_55a4488d2ad5346dd28d",
          "document_start": 453,
          "document_end": 523,
          "text": "同样的模型，因果关系的标识不一样其所确定的系统状态变量和状态方程的形式往往也是不同的，但是它们所反映出的对应真实系统的物理含义应该是一致的。",
          "section_id": "section_cad95f4364d5",
          "start": 453,
          "end": 523,
          "chunk_start": 453,
          "chunk_end": 523,
          "sentence_document_start": 453,
          "sentence_document_end": 523,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_d0c5798054742beb9572",
          "document_start": 525,
          "document_end": 545,
          "text": "[Source paragraph 2;",
          "section_id": "section_cad95f4364d5",
          "start": 525,
          "end": 545,
          "chunk_start": 525,
          "chunk_end": 545,
          "sentence_document_start": 525,
          "sentence_document_end": 545,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_1aacafefcd846b2f7fe2",
          "document_start": 546,
          "document_end": 567,
          "text": "# 5.2.2 键合图模型因果关系的确定;",
          "section_id": "section_cad95f4364d5",
          "start": 546,
          "end": 567,
          "chunk_start": 546,
          "chunk_end": 567,
          "sentence_document_start": 546,
          "sentence_document_end": 567,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e6af5bc054da19aa02aa",
          "document_start": 568,
          "document_end": 600,
          "text": "intervening text may be omitted]",
          "section_id": "section_cad95f4364d5",
          "start": 568,
          "end": 600,
          "chunk_start": 568,
          "chunk_end": 600,
          "sentence_document_start": 568,
          "sentence_document_end": 600,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_8aabbf9b0f7b0f0c178a",
          "document_start": 602,
          "document_end": 640,
          "text": "需要注意：对一个系统模型来讲，因果关系不取决于键合图键序号的标识顺序和方式；",
          "section_id": "section_cad95f4364d5",
          "start": 602,
          "end": 640,
          "chunk_start": 602,
          "chunk_end": 640,
          "sentence_document_start": 602,
          "sentence_document_end": 640,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_8cd776e0edd083edd8f9",
          "document_start": 640,
          "document_end": 677,
          "text": "而且对于一正确的系统模型来讲，可以确定出的系统模型因果关系也可能不止一个。",
          "section_id": "section_cad95f4364d5",
          "start": 640,
          "end": 677,
          "chunk_start": 640,
          "chunk_end": 677,
          "sentence_document_start": 640,
          "sentence_document_end": 677,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_127236554dae6b84840a",
          "document_start": 677,
          "document_end": 731,
          "text": "功率流向的选择和因果关系的确定是完全独立的，哪一个先行都可以，但通常习惯上是先确定功率流向，后确定因果关系。",
          "section_id": "section_cad95f4364d5",
          "start": 677,
          "end": 731,
          "chunk_start": 677,
          "chunk_end": 731,
          "sentence_document_start": 677,
          "sentence_document_end": 731,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c8e0cb76106d291dd299",
          "document_start": 731,
          "document_end": 815,
          "text": "就自动机来讲，这种能量变量的替换实质上就是由具有积分关系的能量元件所确定的能量变量在系统中的传递，而这种传递关系体现为传递路线上转换器模数和相连摩阻元件的一种连乘关系。",
          "section_id": "section_cad95f4364d5",
          "start": 731,
          "end": 815,
          "chunk_start": 731,
          "chunk_end": 815,
          "sentence_document_start": 731,
          "sentence_document_end": 815,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_253b179c9eff3872f882",
          "document_start": 817,
          "document_end": 837,
          "text": "[Source paragraph 3;",
          "section_id": "section_cad95f4364d5",
          "start": 817,
          "end": 837,
          "chunk_start": 817,
          "chunk_end": 837,
          "sentence_document_start": 817,
          "sentence_document_end": 837,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_95d27b49d77d247f96c3",
          "document_start": 838,
          "document_end": 856,
          "text": "# 5.2.3 系统状态方程的列写;",
          "section_id": "section_cad95f4364d5",
          "start": 838,
          "end": 856,
          "chunk_start": 838,
          "chunk_end": 856,
          "sentence_document_start": 838,
          "sentence_document_end": 856,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_a64050d5f995e8021e86",
          "document_start": 857,
          "document_end": 889,
          "text": "intervening text may be omitted]",
          "section_id": "section_cad95f4364d5",
          "start": 857,
          "end": 889,
          "chunk_start": 857,
          "chunk_end": 889,
          "sentence_document_start": 857,
          "sentence_document_end": 889,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_0384e6590d78657b8b5a",
          "document_start": 891,
          "document_end": 1028,
          "text": "应用键合图和键合空间理论的最大的优点在于，在系统状态方程建立以前，我们就可以通过对键合图模型的考察对系统状态方程的形式进行研究，并且应用键合图理论由键合图模型列出系统状态方程的过程可以看成一个标准的程式，这样既方便系统状态方程的确立，同时又便于实现系统模型的计算机自动推导。",
          "section_id": "section_cad95f4364d5",
          "start": 891,
          "end": 1028,
          "chunk_start": 891,
          "chunk_end": 1028,
          "sentence_document_start": 891,
          "sentence_document_end": 1028,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_d6271e371e9b30985abc",
          "document_start": 1030,
          "document_end": 1050,
          "text": "[Source paragraph 4;",
          "section_id": "section_cad95f4364d5",
          "start": 1030,
          "end": 1050,
          "chunk_start": 1030,
          "chunk_end": 1050,
          "sentence_document_start": 1030,
          "sentence_document_end": 1050,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9e088b2a3bf741868d86",
          "document_start": 1051,
          "document_end": 1068,
          "text": "# 一、键合图模型状态方程的列写;",
          "section_id": "section_cad95f4364d5",
          "start": 1051,
          "end": 1068,
          "chunk_start": 1051,
          "chunk_end": 1068,
          "sentence_document_start": 1051,
          "sentence_document_end": 1068,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_789cdb35a6c43ad371a4",
          "document_start": 1069,
          "document_end": 1101,
          "text": "intervening text may be omitted]",
          "section_id": "section_cad95f4364d5",
          "start": 1069,
          "end": 1101,
          "chunk_start": 1069,
          "chunk_end": 1101,
          "sentence_document_start": 1069,
          "sentence_document_end": 1101,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_4fecf9d6f48923f6b8be",
          "document_start": 1103,
          "document_end": 1163,
          "text": "全积分关系键合图模型状态方程的例写比较容易，但实际应用中，特别像在自动机模拟中，遇到的更多的是包含微分关系的键合图模型。",
          "section_id": "section_cad95f4364d5",
          "start": 1103,
          "end": 1163,
          "chunk_start": 1103,
          "chunk_end": 1163,
          "sentence_document_start": 1103,
          "sentence_document_end": 1163,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_1121ad027eefc54725ea",
          "document_start": 1163,
          "document_end": 1191,
          "text": "下面就主要论述具有微分关系键合图模型状态方程列写的问题。",
          "section_id": "section_cad95f4364d5",
          "start": 1163,
          "end": 1191,
          "chunk_start": 1163,
          "chunk_end": 1191,
          "sentence_document_start": 1163,
          "sentence_document_end": 1191,
          "sentence_complete": true
        }
      ],
