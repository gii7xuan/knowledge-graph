    },
    {
      "sentence_id": "sentence_7628e34a5e10e31c8d28",
      "document_start": 276,
      "document_end": 338,
      "text": "其尺寸小、重量轻、结构牢固，一般采用气体阻尼，内装有过量程限止器，具有零频响应、零位漂移量小、线性好、工作温度范围宽等特点。",
      "section_id": "section_fe9ddb4d2040"
    },
    {
      "sentence_id": "sentence_1011f2be39b761c0f6fc",
      "document_start": 340,
      "document_end": 360,
      "text": "[Source paragraph 3;",
      "section_id": "section_fe9ddb4d2040"
    },
    {
