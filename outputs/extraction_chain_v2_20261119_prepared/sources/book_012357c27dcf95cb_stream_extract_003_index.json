          "sentence_document_start": 38,
          "sentence_document_end": 58,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5303693323745e949adb",
          "document_start": 59,
          "document_end": 71,
          "text": "# 2）拉格朗日方程法;",
          "section_id": "section_3e1eaff5ba70",
          "start": 59,
          "end": 71,
          "chunk_start": 59,
          "chunk_end": 71,
          "sentence_document_start": 59,
          "sentence_document_end": 71,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c11aaf7fa6382f68c109",
          "document_start": 72,
          "document_end": 104,
          "text": "intervening text may be omitted]",
          "section_id": "section_3e1eaff5ba70",
          "start": 72,
          "end": 104,
          "chunk_start": 72,
          "chunk_end": 104,
          "sentence_document_start": 72,
          "sentence_document_end": 104,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b6ab6a7bd5315be5b53b",
          "document_start": 106,
          "document_end": 195,
          "text": "豪格（Haug）等人选取的笛卡儿广义坐标，研究了广义坐标分类、奇异值分解等算法，编制了计算机程序DADS（Dynamic Analysis and Design System）。",
          "section_id": "section_3e1eaff5ba70",
          "start": 106,
          "end": 195,
          "chunk_start": 106,
          "chunk_end": 195,
          "sentence_document_start": 106,
          "sentence_document_end": 195,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2cb93780e265e97429e0",
          "document_start": 197,
          "document_end": 217,
          "text": "[Source paragraph 2;",
          "section_id": "section_3e1eaff5ba70",
          "start": 197,
          "end": 217,
          "chunk_start": 197,
          "chunk_end": 217,
          "sentence_document_start": 197,
          "sentence_document_end": 217,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5fad0198f167a360e276",
          "document_start": 218,
          "document_end": 227,
          "text": "# 3）图论方法;",
          "section_id": "section_3e1eaff5ba70",
          "start": 218,
          "end": 227,
          "chunk_start": 218,
          "chunk_end": 227,
          "sentence_document_start": 218,
          "sentence_document_end": 227,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5da48df4715d92a8c447",
          "document_start": 228,
          "document_end": 260,
          "text": "intervening text may be omitted]",
          "section_id": "section_3e1eaff5ba70",
          "start": 228,
          "end": 260,
          "chunk_start": 228,
          "chunk_end": 260,
          "sentence_document_start": 228,
          "sentence_document_end": 260,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9ddabed8994c889d2edd",
          "document_start": 262,
          "document_end": 347,
          "text": "R-W方法是由罗伯逊（Roberson）和维登伯格（Wittenburg）提出的，他们利用图论的一些基本概念和数学工具成功地描绘系统内各刚体之间的联系情况，即系统的结构。",
          "section_id": "section_3e1eaff5ba70",
          "start": 262,
          "end": 347,
          "chunk_start": 262,
          "chunk_end": 347,
          "sentence_document_start": 262,
          "sentence_document_end": 347,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_cd4fe0502045432cc107",
          "document_start": 347,
          "document_end": 409,
          "text": "R-W方法以相邻刚体之间的相对位移作广义坐标，对复杂的树结构动力学关系给出了统一的数学模式，得到了系统的非线性运动微分方程。",
          "section_id": "section_3e1eaff5ba70",
          "start": 347,
          "end": 409,
          "chunk_start": 347,
          "chunk_end": 409,
          "sentence_document_start": 347,
          "sentence_document_end": 409,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2d43cd87e84a31a8f320",
          "document_start": 409,
          "document_end": 441,
          "text": "对于非树系统，则利用铰切割或刚体分割的方法将其转变成树系统处理。",
          "section_id": "section_3e1eaff5ba70",
          "start": 409,
          "end": 441,
          "chunk_start": 409,
          "chunk_end": 441,
          "sentence_document_start": 409,
          "sentence_document_end": 441,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2fa5b3cfcb322ae7e62f",
          "document_start": 443,
          "document_end": 463,
          "text": "[Source paragraph 3;",
          "section_id": "section_3e1eaff5ba70",
          "start": 443,
          "end": 463,
          "chunk_start": 443,
          "chunk_end": 463,
          "sentence_document_start": 443,
          "sentence_document_end": 463,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_6828a8a39753b1b715d7",
          "document_start": 464,
          "document_end": 473,
          "text": "# 4）凯恩方法;",
          "section_id": "section_3e1eaff5ba70",
          "start": 464,
          "end": 473,
          "chunk_start": 464,
          "chunk_end": 473,
          "sentence_document_start": 464,
          "sentence_document_end": 473,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5a506cfdebff48bfab6f",
          "document_start": 474,
          "document_end": 506,
          "text": "intervening text may be omitted]",
          "section_id": "section_3e1eaff5ba70",
          "start": 474,
          "end": 506,
          "chunk_start": 474,
          "chunk_end": 506,
          "sentence_document_start": 474,
          "sentence_document_end": 506,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b8cb9238cf5e5b86acfa",
          "document_start": 508,
          "document_end": 651,
          "text": "凯恩方法是建立一般多自由度离散系统动力学方程的一种普遍方法，其特点是以伪速度作为独立变量来描述系统的运动，既适合于完整系统，也适合于非完整系统，在建立动力学方程中不出现理想约束反力，也不必计算动能等动力学函数及其导数，只需要进行矢量点积、叉积等运算，推导计算规格化，得到1阶微分方程组。",
          "section_id": "section_3e1eaff5ba70",
          "start": 508,
          "end": 651,
          "chunk_start": 508,
          "chunk_end": 651,
          "sentence_document_start": 508,
          "sentence_document_end": 651,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b8ebd5de9d00f4adfae9",
          "document_start": 651,
          "document_end": 699,
          "text": "但凯恩方法并没有给出一个适合于任意多刚体系统的动力学方程，广义速度的选择也需要一定的经验和技巧。",
          "section_id": "section_3e1eaff5ba70",
          "start": 651,
          "end": 699,
          "chunk_start": 651,
          "chunk_end": 699,
          "sentence_document_start": 651,
          "sentence_document_end": 699,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_756857300ea93b625193",
          "document_start": 701,
          "document_end": 721,
          "text": "[Source paragraph 4;",
          "section_id": "section_3e1eaff5ba70",
          "start": 701,
          "end": 721,
          "chunk_start": 701,
          "chunk_end": 721,
          "sentence_document_start": 701,
          "sentence_document_end": 721,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_d5f3b24419657c01cdcc",
          "document_start": 722,
          "document_end": 731,
          "text": "# 5）变分方法;",
          "section_id": "section_3e1eaff5ba70",
          "start": 722,
          "end": 731,
          "chunk_start": 722,
          "chunk_end": 731,
          "sentence_document_start": 722,
          "sentence_document_end": 731,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_7ccc704d5b6451768d2e",
          "document_start": 732,
          "document_end": 764,
          "text": "intervening text may be omitted]",
          "section_id": "section_3e1eaff5ba70",
          "start": 732,
          "end": 764,
          "chunk_start": 732,
          "chunk_end": 764,
          "sentence_document_start": 732,
          "sentence_document_end": 764,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9d8f7c809874b44aeb43",
          "document_start": 766,
          "document_end": 856,
          "text": "变分的力学原理并不直接描述机械运动的客观规律，而是把真实发生的运动和可能发生的运动加以比较，在相同条件下可能发生的运动中指出真实运动所应满足的条件，揭示真实运动所具有的性质和规律。",
          "section_id": "section_3e1eaff5ba70",
          "start": 766,
          "end": 856,
          "chunk_start": 766,
          "chunk_end": 856,
          "sentence_document_start": 766,
          "sentence_document_end": 856,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_04ac1f5e79d7cbf328e8",
          "document_start": 856,
          "document_end": 1004,
          "text": "用变分方法研究多刚体动力学问题，不需要列出运动微分方程，而是根据某个泛函的极值条件，直接利用系统在每个时刻的坐标及速度值解出加速度，从而确定系统的运动规律，利用各种有效的数学规律寻求泛函极值，对于带控制系统的多刚体系统，动力学分析可与系统的优化结合进行，对于树形或非树形系统都可用同样的方法处理。",
          "section_id": "section_3e1eaff5ba70",
          "start": 856,
          "end": 1004,
          "chunk_start": 856,
          "chunk_end": 1004,
          "sentence_document_start": 856,
          "sentence_document_end": 1004,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_55d63d3f9b4af0c65f5e",
          "document_start": 1004,
          "document_end": 1049,
          "text": "变分方法对于系统内包含的封闭链数目不加限制，因而变分方法是解决工程实际问题的一种重要方法。",
          "section_id": "section_3e1eaff5ba70",
          "start": 1004,
          "end": 1049,
          "chunk_start": 1004,
          "chunk_end": 1049,
          "sentence_document_start": 1004,
          "sentence_document_end": 1049,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_842ca398e423f3610c51",
          "document_start": 1051,
          "document_end": 1071,
          "text": "[Source paragraph 5;",
          "section_id": "section_3e1eaff5ba70",
          "start": 1051,
          "end": 1071,
          "chunk_start": 1051,
          "chunk_end": 1071,
          "sentence_document_start": 1051,
          "sentence_document_end": 1071,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c62f4256382dbe315449",
          "document_start": 1072,
          "document_end": 1081,
          "text": "# 5）变分方法;",
          "section_id": "section_3e1eaff5ba70",
          "start": 1072,
          "end": 1081,
          "chunk_start": 1072,
          "chunk_end": 1081,
          "sentence_document_start": 1072,
          "sentence_document_end": 1081,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_eebd4ced8679df56fdbb",
          "document_start": 1082,
          "document_end": 1114,
          "text": "intervening text may be omitted]",
          "section_id": "section_3e1eaff5ba70",
          "start": 1082,
          "end": 1114,
          "chunk_start": 1082,
          "chunk_end": 1114,
          "sentence_document_start": 1082,
          "sentence_document_end": 1114,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_8e4ce81e2c8b309d5821",
          "document_start": 1116,
          "document_end": 1172,
          "text": "高斯提出了最小拘束原理：一个力学系统的真实运动与位置及速度相同但加速度不同的可能运动相比较，其拘束度具有最小值。",
          "section_id": "section_3e1eaff5ba70",
          "start": 1116,
          "end": 1172,
          "chunk_start": 1116,
          "chunk_end": 1172,
          "sentence_document_start": 1116,
          "sentence_document_end": 1172,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c433847aa83e7e020f25",
          "document_start": 1172,
          "document_end": 1200,
          "text": "将高斯最小拘束原理应用于多刚体系统的研究方法就是变分法。",
          "section_id": "section_3e1eaff5ba70",
          "start": 1172,
          "end": 1200,
          "chunk_start": 1172,
          "chunk_end": 1200,
          "sentence_document_start": 1172,
          "sentence_document_end": 1200,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_ca341e9e305148425cac",
          "document_start": 1200,
          "document_end": 1210,
          "text": "多刚体系统的拘束度为",
          "section_id": "section_3e1eaff5ba70",
          "start": 1200,
          "end": 1210,
          "chunk_start": 1200,
          "chunk_end": 1210,
          "sentence_document_start": 1200,
          "sentence_document_end": 1210,
          "sentence_complete": true
        }
