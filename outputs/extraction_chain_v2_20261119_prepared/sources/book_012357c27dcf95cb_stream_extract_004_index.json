        },
        {
          "sentence_id": "sentence_de604beccab2fdc1d8d4",
          "document_start": 972,
          "document_end": 1053,
          "text": "在力学研究中有4种最基本的约束：垂直(Perpendicular）约束、共点（Atpoint)/球铰约束、点面（Inplane）约束和角度（Angular）约束。",
          "section_id": "section_ea5825ca19f9",
