          "document_end": 58,
          "text": "[Source paragraph 1;",
          "section_id": "section_043f5f7f082c",
          "start": 38,
          "end": 58,
          "chunk_start": 38,
          "chunk_end": 58,
          "sentence_document_start": 38,
          "sentence_document_end": 58,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5994ab6dd8149960c601",
          "document_start": 59,
          "document_end": 74,
          "text": "# 2.2.4 数值求解算法;",
          "section_id": "section_043f5f7f082c",
          "start": 59,
          "end": 74,
          "chunk_start": 59,
          "chunk_end": 74,
          "sentence_document_start": 59,
          "sentence_document_end": 74,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_88d8ea580adefe9a3f85",
          "document_start": 75,
          "document_end": 107,
          "text": "intervening text may be omitted]",
          "section_id": "section_043f5f7f082c",
          "start": 75,
          "end": 107,
          "chunk_start": 75,
          "chunk_end": 107,
          "sentence_document_start": 75,
          "sentence_document_end": 107,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_6103ba47cad35b2815bb",
          "document_start": 109,
          "document_end": 181,
          "text": "增广法将全部的广义坐标与拉格朗日乘子作为未知变量同时求解，此时方程组变为较大变量数的封闭方程，再对加速度进行积分求出广义坐标速度和广义坐标位置。",
          "section_id": "section_043f5f7f082c",
          "start": 109,
          "end": 181,
          "chunk_start": 109,
          "chunk_end": 181,
          "sentence_document_start": 109,
          "sentence_document_end": 181,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_171dd63d3a92a21dda3d",
          "document_start": 181,
          "document_end": 198,
          "text": "增广法包括直接积分法和约束稳定法。",
          "section_id": "section_043f5f7f082c",
          "start": 181,
          "end": 198,
          "chunk_start": 181,
          "chunk_end": 198,
          "sentence_document_start": 181,
          "sentence_document_end": 198,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_307bf7af4156bd97a54d",
          "document_start": 198,
          "document_end": 275,
          "text": "直接法的基本思想是利用解代数方程的数值方法（如高斯消去法），解得加速度和拉氏乘子，然后利用数值积分方法求出速度及位置，但积分过程中误差累积严重，容易发散；",
          "section_id": "section_043f5f7f082c",
          "start": 198,
          "end": 275,
          "chunk_start": 198,
          "chunk_end": 275,
          "sentence_document_start": 198,
          "sentence_document_end": 275,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_0f825a121c2f4e2920ef",
          "document_start": 275,
          "document_end": 324,
          "text": "约束稳定法将控制反馈理论引入微分-代数方程的数值积分过程，以控制违约现象，该方法稳定性好，响应快。",
          "section_id": "section_043f5f7f082c",
          "start": 275,
          "end": 324,
          "chunk_start": 275,
          "chunk_end": 324,
          "sentence_document_start": 275,
          "sentence_document_end": 324,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f80c973de918a7019f7e",
          "document_start": 324,
          "document_end": 393,
          "text": "从表面上看，增广法所解的方程个数比较多，但是方程的系数矩阵呈稀疏状，可以利用稀疏矩阵的特点，采用数值方法减小计算机内存占用，加快解算速度。",
          "section_id": "section_043f5f7f082c",
          "start": 324,
          "end": 393,
          "chunk_start": 324,
          "chunk_end": 393,
          "sentence_document_start": 324,
          "sentence_document_end": 393,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e96861d4cd56b252cfe7",
          "document_start": 395,
          "document_end": 415,
          "text": "[Source paragraph 2;",
          "section_id": "section_043f5f7f082c",
          "start": 395,
          "end": 415,
          "chunk_start": 395,
          "chunk_end": 415,
          "sentence_document_start": 395,
          "sentence_document_end": 415,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_16d339aec31ae83d2b19",
          "document_start": 416,
          "document_end": 420,
          "text": "# 1.",
          "section_id": "section_043f5f7f082c",
          "start": 416,
          "end": 420,
          "chunk_start": 416,
          "chunk_end": 420,
          "sentence_document_start": 416,
          "sentence_document_end": 420,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_bf6e9831e38703aa4707",
          "document_start": 421,
          "document_end": 426,
          "text": "刚性问题;",
          "section_id": "section_043f5f7f082c",
          "start": 421,
          "end": 426,
          "chunk_start": 421,
          "chunk_end": 426,
          "sentence_document_start": 421,
          "sentence_document_end": 426,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_00705491d8a9057d015e",
          "document_start": 427,
          "document_end": 459,
          "text": "intervening text may be omitted]",
          "section_id": "section_043f5f7f082c",
          "start": 427,
          "end": 459,
          "chunk_start": 427,
          "chunk_end": 459,
          "sentence_document_start": 427,
          "sentence_document_end": 459,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_441cf81fee63ef9f1258",
          "document_start": 461,
          "document_end": 503,
          "text": "微分-代数方程的求解，无论是缩并法还是增广法，最终都归结为常微分方程初值问题的求解。",
          "section_id": "section_043f5f7f082c",
          "start": 461,
          "end": 503,
          "chunk_start": 461,
          "chunk_end": 503,
          "sentence_document_start": 461,
          "sentence_document_end": 503,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_512e08bc8399ac4cbfde",
          "document_start": 503,
          "document_end": 592,
          "text": "在可以用常微分方程描述的许多物理、力学过程中，常常包含许多复杂的子过程及它们之间的相互作用，其中有的子过程表现为快变化，另一些相对来说是慢变化，并且变化速度可以相差非常大的量级。",
          "section_id": "section_043f5f7f082c",
          "start": 503,
          "end": 592,
          "chunk_start": 503,
          "chunk_end": 592,
          "sentence_document_start": 503,
          "sentence_document_end": 592,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_013dcb2bf3606ad2b8ad",
          "document_start": 592,
          "document_end": 624,
          "text": "相应地，描述这些过程的常微分方程的解中也包含快变分量和慢变分量。",
          "section_id": "section_043f5f7f082c",
          "start": 592,
          "end": 624,
          "chunk_start": 592,
          "chunk_end": 624,
          "sentence_document_start": 592,
          "sentence_document_end": 624,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2c4e7ec73f4eaac350cd",
          "document_start": 624,
          "document_end": 649,
          "text": "如果在一个过程中，快、慢子过程变化的速度差别达到一",
          "section_id": "section_043f5f7f082c",
          "start": 624,
          "end": 649,
          "chunk_start": 624,
          "chunk_end": 649,
          "sentence_document_start": 624,
          "sentence_document_end": 649,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_594e8582320d83246261",
          "document_start": 651,
          "document_end": 671,
          "text": "[Source paragraph 3;",
          "section_id": "section_043f5f7f082c",
          "start": 651,
          "end": 671,
          "chunk_start": 651,
          "chunk_end": 671,
          "sentence_document_start": 651,
          "sentence_document_end": 671,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_bd5d4652fff1c607ebf1",
          "document_start": 672,
          "document_end": 676,
          "text": "# 1.",
          "section_id": "section_043f5f7f082c",
          "start": 672,
          "end": 676,
          "chunk_start": 672,
          "chunk_end": 676,
          "sentence_document_start": 672,
          "sentence_document_end": 676,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c018bba0de642a94dfcf",
          "document_start": 677,
          "document_end": 682,
          "text": "刚性问题;",
          "section_id": "section_043f5f7f082c",
          "start": 677,
          "end": 682,
          "chunk_start": 677,
          "chunk_end": 682,
          "sentence_document_start": 677,
          "sentence_document_end": 682,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c507ddf32245c0ea79bb",
          "document_start": 683,
          "document_end": 715,
          "text": "intervening text may be omitted]",
          "section_id": "section_043f5f7f082c",
          "start": 683,
          "end": 715,
          "chunk_start": 683,
          "chunk_end": 715,
          "sentence_document_start": 683,
          "sentence_document_end": 715,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e6ebb44fe7e2ed122df1",
          "document_start": 717,
          "document_end": 761,
          "text": "定量级，在数学上称这种系统具有刚性性质，描述这类变化过程的常微分方程系统则称为刚性系统。",
          "section_id": "section_043f5f7f082c",
          "start": 717,
          "end": 761,
          "chunk_start": 717,
          "chunk_end": 761,
          "sentence_document_start": 717,
          "sentence_document_end": 761,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_50f01f0f708e0ec92e47",
          "document_start": 761,
          "document_end": 779,
          "text": "刚性方程也称为病态方程或坏条件方程。",
          "section_id": "section_043f5f7f082c",
          "start": 761,
          "end": 779,
          "chunk_start": 761,
          "chunk_end": 779,
          "sentence_document_start": 761,
          "sentence_document_end": 779,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f9e1c8198a8bd1dc99d4",
          "document_start": 779,
          "document_end": 816,
          "text": "刚性问题存在于多刚体系统动力学的某些情形，更普遍存在于多柔体系统动力学中。",
          "section_id": "section_043f5f7f082c",
          "start": 779,
          "end": 816,
          "chunk_start": 779,
          "chunk_end": 816,
          "sentence_document_start": 779,
          "sentence_document_end": 816,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5ade191702a5a79896fc",
          "document_start": 816,
          "document_end": 889,
          "text": "比如在多刚体系统运动过程中，可能会由于系统中构件之间的差异过大，导致系统中构件运动速度差别很大，从而使描述系统运动的微分-代数方程呈现出刚性特征。",
          "section_id": "section_043f5f7f082c",
          "start": 816,
          "end": 889,
          "chunk_start": 816,
          "chunk_end": 889,
          "sentence_document_start": 816,
          "sentence_document_end": 889,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e1e93f05c5b75fb44120",
          "document_start": 891,
          "document_end": 911,
          "text": "[Source paragraph 4;",
          "section_id": "section_043f5f7f082c",
          "start": 891,
          "end": 911,
          "chunk_start": 891,
          "chunk_end": 911,
          "sentence_document_start": 891,
          "sentence_document_end": 911,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_a3a671a6fed6b9f193f2",
          "document_start": 912,
          "document_end": 930,
          "text": "# 2）坐标缩减的微分方程求解算法;",
          "section_id": "section_043f5f7f082c",
          "start": 912,
          "end": 930,
          "chunk_start": 912,
          "chunk_end": 930,
          "sentence_document_start": 912,
          "sentence_document_end": 930,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_0caf44d868f42122b067",
          "document_start": 931,
          "document_end": 963,
          "text": "intervening text may be omitted]",
          "section_id": "section_043f5f7f082c",
          "start": 931,
          "end": 963,
          "chunk_start": 931,
          "chunk_end": 963,
          "sentence_document_start": 931,
          "sentence_document_end": 963,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_75a47a59d21a060f33ca",
          "document_start": 965,
          "document_end": 1106,
          "text": "在模拟特征值经历突变的系统或高频系统时，采用坐标分离算法将微分-代数方程缩减为用独立广义坐标表示的纯微分方程，然后用ABAM（Adams-Bashforth and Adams-Moulton）或RKF45［Runge-Kutta-Fehlberg（4，5）］积分程序进行数值积分。",
          "section_id": "section_043f5f7f082c",
          "start": 965,
          "end": 1106,
          "chunk_start": 965,
          "chunk_end": 1106,
          "sentence_document_start": 965,
          "sentence_document_end": 1106,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_db2a482adbc61a5b3751",
          "document_start": 1106,
          "document_end": 1130,
          "text": "ABAM和RKF45积分程序皆为非刚性稳定算法。",
          "section_id": "section_043f5f7f082c",
          "start": 1106,
          "end": 1130,
          "chunk_start": 1106,
          "chunk_end": 1130,
          "sentence_document_start": 1106,
          "sentence_document_end": 1130,
          "sentence_complete": true
        }
      ],
