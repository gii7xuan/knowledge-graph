    },
    {
      "sentence_id": "sentence_1ca760a9e1501f23433c",
      "document_start": 1288,
      "document_end": 1322,
      "text": "循环图特征点包括构件速度突变点（碰撞点）、进入运动点和退出运动点等。",
      "section_id": "section_ab798d91a402"
    },
