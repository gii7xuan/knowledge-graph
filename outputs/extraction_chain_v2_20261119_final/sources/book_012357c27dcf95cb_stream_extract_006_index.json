        {
          "sentence_id": "sentence_d03a232b8f8fe9f9aad0",
          "document_start": 760,
          "document_end": 769,
          "text": "结构的动力学问题。",
          "section_id": "section_92dd7d4d544d",
          "start": 760,
          "end": 769,
          "chunk_start": 760,
          "chunk_end": 769,
          "sentence_document_start": 760,
