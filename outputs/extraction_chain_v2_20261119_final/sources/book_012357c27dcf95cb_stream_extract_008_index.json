        },
        {
          "sentence_id": "sentence_ebd407daa4ad2742e816",
          "document_start": 1038,
          "document_end": 1047,
          "text": "碰撞动力学的算法;",
          "section_id": "section_34e0470d368b",
          "start": 1038,
          "end": 1047,
          "chunk_start": 1038,
          "chunk_end": 1047,
          "sentence_document_start": 1038,
          "sentence_document_end": 1047,
