      "document_id": "book_012357c27dcf95cb_stream_extract_010",
      "document_version": "2d04fedf000a1c0b1315e06bb51a492b2861d78265a185cee1262930b9e5001e",
      "chunk_id": "chunk_77d0fc6a89d5",
