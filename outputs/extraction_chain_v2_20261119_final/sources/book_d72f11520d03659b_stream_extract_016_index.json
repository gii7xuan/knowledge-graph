        },
        {
          "sentence_id": "sentence_d52c5d3d4d8beaaab47a",
          "document_start": 363,
          "document_end": 378,
          "text": "这类力学模型称为柔性多体系统。",
          "section_id": "section_e7bc064d6c66",
          "start": 363,
          "end": 378,
          "chunk_start": 363,
          "chunk_end": 378,
          "sentence_document_start": 363,
