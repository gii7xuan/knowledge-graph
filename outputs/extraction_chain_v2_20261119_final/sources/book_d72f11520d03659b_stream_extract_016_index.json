        {
          "sentence_id": "sentence_31ecdf7a90562aa8bebe",
          "document_start": 101,
          "document_end": 115,
          "text": "多体系统中的构件定义为物体。",
          "section_id": "section_e7bc064d6c66",
          "start": 101,
          "end": 115,
          "chunk_start": 101,
          "chunk_end": 115,
          "sentence_document_start": 101,
          "sentence_document_end": 115,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_44d74424e36218d0467f",
          "document_start": 115,
          "document_end": 149,
          "text": "多体系统力学模型中物体的定义并不一定与具体工程对象的零部件一一对应。",
          "section_id": "section_e7bc064d6c66",
          "start": 115,
          "end": 149,
          "chunk_start": 115,
          "chunk_end": 149,
          "sentence_document_start": 115,
          "sentence_document_end": 149,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_df5bebc05c3ea1badb13",
          "document_start": 149,
          "document_end": 162,
          "text": "它的定义与研究的目的有关。",
          "section_id": "section_e7bc064d6c66",
          "start": 149,
          "end": 162,
          "chunk_start": 149,
          "chunk_end": 162,
          "sentence_document_start": 149,
