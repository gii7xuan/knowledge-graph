          "chunk_end": 192,
          "sentence_document_start": 162,
          "sentence_document_end": 192,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9f90df4e2b23fb8c4e45",
          "document_start": 192,
          "document_end": 203,
          "text": "其次是物体性质的假定。",
          "section_id": "section_e7bc064d6c66",
          "start": 192,
          "end": 203,
          "chunk_start": 192,
          "chunk_end": 203,
          "sentence_document_start": 192,
          "sentence_document_end": 203,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f3a8776c0eb363ac87f0",
          "document_start": 203,
          "document_end": 240,
          "text": "对于低速运动的实际工程对象，其零部件的弹性变形并不影响其大范围的运动性态。",
          "section_id": "section_e7bc064d6c66",
          "start": 203,
          "end": 240,
          "chunk_start": 203,
          "chunk_end": 240,
          "sentence_document_start": 203,
          "sentence_document_end": 240,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_6f7223b37fb2accf891d",
          "document_start": 240,
          "document_end": 260,
          "text": "在这种情况下，系统中的物体可作刚体假定。",
          "section_id": "section_e7bc064d6c66",
          "start": 240,
          "end": 260,
          "chunk_start": 240,
          "chunk_end": 260,
          "sentence_document_start": 240,
          "sentence_document_end": 260,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e30c7241382fe2a1deb0",
          "document_start": 260,
          "document_end": 275,
          "text": "这样的多体系统称为多刚体系统。",
          "section_id": "section_e7bc064d6c66",
          "start": 260,
          "end": 275,
          "chunk_start": 260,
          "chunk_end": 275,
          "sentence_document_start": 260,
          "sentence_document_end": 275,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9520ab1f11c4f42c05e3",
          "document_start": 275,
          "document_end": 340,
          "text": "由于大型、轻质机械系统的出现，高速运行的工况将使系统动力学性态越来越复杂，这些现象由于零部件的大范围运动与构件的弹性变形耦合引起。",
          "section_id": "section_e7bc064d6c66",
          "start": 275,
          "end": 340,
          "chunk_start": 275,
          "chunk_end": 340,
          "sentence_document_start": 275,
          "sentence_document_end": 340,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_d37d35a4c2b0e3ec5025",
          "document_start": 340,
          "document_end": 363,
          "text": "在分析这类系统动力学时，物体必须作柔性体假定。",
          "section_id": "section_e7bc064d6c66",
          "start": 340,
          "end": 363,
          "chunk_start": 340,
          "chunk_end": 363,
          "sentence_document_start": 340,
