        },
        {
          "sentence_id": "sentence_9dce4b4b93e2a4f47ba4",
          "document_start": 351,
          "document_end": 366,
          "text": "正确指定键合图模型的功率流向。",
          "section_id": "section_7ff7235905e8",
          "start": 351,
          "end": 366,
          "chunk_start": 351,
