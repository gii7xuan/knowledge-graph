          "chunk_start": 445,
          "chunk_end": 513,
          "sentence_document_start": 445,
          "sentence_document_end": 513,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2faad362aa1f0d64b3ad",
          "document_start": 513,
          "document_end": 524,
          "text": "对每根键指定功率方向；",
          "section_id": "section_7ff7235905e8",
          "start": 513,
          "end": 524,
          "chunk_start": 513,
          "chunk_end": 524,
          "sentence_document_start": 513,
