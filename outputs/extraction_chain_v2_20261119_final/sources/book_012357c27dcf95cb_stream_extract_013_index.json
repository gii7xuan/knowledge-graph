        },
        {
          "sentence_id": "sentence_58865cef11ef8408fb11",
          "document_start": 956,
          "document_end": 986,
          "text": "过多的实体和相互关系，不但难以获得，即使能获得，也难以处理。",
          "section_id": "section_47deb280bb7b",
          "start": 956,
