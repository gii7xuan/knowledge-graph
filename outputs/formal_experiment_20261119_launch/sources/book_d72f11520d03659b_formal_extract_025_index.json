          "chunk_end": 482,
          "sentence_document_start": 467,
          "sentence_document_end": 482,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_1dca186e84eaa6779bd0",
          "document_start": 483,
          "document_end": 515,
          "text": "intervening text may be omitted]",
          "section_id": "section_aadadd64230a",
          "start": 483,
          "end": 515,
          "chunk_start": 483,
          "chunk_end": 515,
          "sentence_document_start": 483,
          "sentence_document_end": 515,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_36317e4af671ebd27db0",
          "document_start": 517,
          "document_end": 670,
          "text": "不同能量范畴的系统，由于其元件运动的形式和能量传递的方式的差异，功率的体现不同，如在机械系统中，对于作用在平动刚体上的力，功率等于力和力在其方向上的速度投影的乘积，对于刚体平面转动，功率等于力矩和角速度的乘积，在电子线路中，功率等于电流和电压的乘积，在液压和气压系统的管路中，功率等于压力和体积流量的乘积。",
          "section_id": "section_aadadd64230a",
          "start": 517,
          "end": 670,
          "chunk_start": 517,
          "chunk_end": 670,
          "sentence_document_start": 517,
          "sentence_document_end": 670,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_477986841012442b5857",
          "document_start": 670,
          "document_end": 696,
          "text": "这种在系统间和系统内部功率传递的地方我们就称为通口。",
          "section_id": "section_aadadd64230a",
          "start": 670,
          "end": 696,
          "chunk_start": 670,
          "chunk_end": 696,
          "sentence_document_start": 670,
          "sentence_document_end": 696,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2931102f6bc85a2585d8",
          "document_start": 696,
          "document_end": 770,
          "text": "功率本身是一个标量，在上面几种情况中，功率是两个互为因果关系物理量的乘积，从广义上讲，我们就把这种形成功率传递的互为因果关系的量称为“势”和“流”。",
          "section_id": "section_aadadd64230a",
          "start": 696,
          "end": 770,
          "chunk_start": 696,
          "chunk_end": 770,
          "sentence_document_start": 696,
          "sentence_document_end": 770,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_871faa292dcb62888c76",
          "document_start": 770,
          "document_end": 906,
          "text": "在键合图理论中，一般把势和流当成标量处理，这样虽然可以不涉及键合空间的概念，但带来处理问题的方便，由于实际系统中很多可以表示为势和流的物理量是矢量，如作用在刚体上的力和速度等，因此为了更好地反映系统的真实状况并具有更普遍的意义，将“势”和“流”处理为在有限维空间中的矢量。",
          "section_id": "section_aadadd64230a",
          "start": 770,
          "end": 906,
          "chunk_start": 770,
          "chunk_end": 906,
          "sentence_document_start": 770,
          "sentence_document_end": 906,
          "sentence_complete": true
        }
      ],
