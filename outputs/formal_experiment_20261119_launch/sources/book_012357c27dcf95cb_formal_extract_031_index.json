    {
      "sentence_id": "sentence_7281d1c0a27ce8111561",
      "document_start": 64,
      "document_end": 69,
      "text": "刚性问题;",
      "section_id": "section_4e839846da57"
    },
    {
      "sentence_id": "sentence_1d6c947eefb71a7c3134",
      "document_start": 70,
