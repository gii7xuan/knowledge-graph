        {
          "sentence_id": "sentence_f14a7c42961321accd93",
          "document_start": 1523,
          "document_end": 1535,
          "text": "（3）动力学方程的建立。",
          "section_id": "section_21b2600cae29",
          "start": 1523,
          "end": 1535,
          "chunk_start": 1523,
          "chunk_end": 1535,
          "sentence_document_start": 1523,
          "sentence_document_end": 1535,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f020a702ea3aa98da034",
          "document_start": 1535,
          "document_end": 1589,
          "text": "目前多柔体动力学方程形式很多，有拉格朗日方程、牛顿-欧拉方程、Appell方程、采用凯恩方程的休斯敦方法等。",
          "section_id": "section_21b2600cae29",
          "start": 1535,
          "end": 1589,
          "chunk_start": 1535,
          "chunk_end": 1589,
          "sentence_document_start": 1535,
