        },
        {
          "sentence_id": "sentence_bd9172b7c16411a67147",
          "document_start": 725,
          "document_end": 765,
          "text": "同样对于出现在系统模型中的0结和1结的因果关系也应该满足其定义所要求的因果关系。",
          "section_id": "section_b8cb25c6b76e",
