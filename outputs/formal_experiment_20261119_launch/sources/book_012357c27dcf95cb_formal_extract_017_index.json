      "sentence_id": "sentence_c64b087e18f8b9137a80",
      "document_start": 64,
      "document_end": 71,
      "text": "系统约束方程;",
      "section_id": "section_3c29513b998c"
    },
    {
      "sentence_id": "sentence_076689ff46b9d1e2cdc5",
