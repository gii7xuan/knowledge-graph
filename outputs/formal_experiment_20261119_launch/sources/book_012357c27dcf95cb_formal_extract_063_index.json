          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b7107757a8a830157d4e",
          "document_start": 502,
          "document_end": 541,
          "text": "其结构简单、使用可靠、横向效应小，可以从零频测量开始，适用于低频振动信号测量。",
          "section_id": "section_69878c707ad9",
          "start": 502,
          "end": 541,
          "chunk_start": 502,
          "chunk_end": 541,
          "sentence_document_start": 502,
