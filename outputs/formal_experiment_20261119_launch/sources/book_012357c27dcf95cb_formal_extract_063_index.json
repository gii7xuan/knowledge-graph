        },
        {
          "sentence_id": "sentence_7c6353c270e70cfc3345",
          "document_start": 475,
          "document_end": 502,
          "text": "应变加速度传感器利用电阻应变片作为敏感元件测量加速度。",
          "section_id": "section_69878c707ad9",
          "start": 475,
          "end": 502,
          "chunk_start": 475,
