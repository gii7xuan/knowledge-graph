          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_d4f79de82c8db086540c",
          "document_start": 541,
          "document_end": 551,
          "text": "其缺点是灵敏度较低。",
          "section_id": "section_69878c707ad9",
          "start": 541,
