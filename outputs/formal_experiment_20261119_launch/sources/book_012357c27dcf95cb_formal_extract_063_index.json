        {
          "sentence_id": "sentence_7b150f2a0db3aaf42ba3",
          "document_start": 621,
          "document_end": 645,
          "text": "电容式加速度传感器利用变电容敏感元件测量加速度。",
          "section_id": "section_69878c707ad9",
          "start": 621,
          "end": 645,
          "chunk_start": 621,
          "chunk_end": 645,
          "sentence_document_start": 621,
