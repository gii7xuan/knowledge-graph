          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_49f9f4c212b040aad0e3",
          "document_start": 358,
          "document_end": 405,
          "text": "对于具有多余坐标的完整约束系统或非完整约束系统，用带乘子的拉格朗日方程处理是一种规格化的方法。",
          "section_id": "section_d75be77411d1",
          "start": 358,
          "end": 405,
          "chunk_start": 358,
          "chunk_end": 405,
          "sentence_document_start": 358,
          "sentence_document_end": 405,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5a7f077c0700a580f86b",
          "document_start": 405,
          "document_end": 468,
          "text": "导出的以笛卡儿广义坐标为变量的动力学方程是与广义坐标数目相同，且带乘子的微分方程，同时需要补充广义坐标的代数约束方程才能封闭。",
          "section_id": "section_d75be77411d1",
          "start": 405,
          "end": 468,
          "chunk_start": 405,
          "chunk_end": 468,
          "sentence_document_start": 405,
          "sentence_document_end": 468,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_adb5127355a6a2ad8ba1",
          "document_start": 470,
          "document_end": 490,
          "text": "[Source paragraph 3;",
          "section_id": "section_d75be77411d1",
          "start": 470,
          "end": 490,
          "chunk_start": 470,
          "chunk_end": 490,
          "sentence_document_start": 470,
          "sentence_document_end": 490,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_7f43aa309fba1898aea5",
          "document_start": 491,
          "document_end": 503,
          "text": "# 2）拉格朗日方程法;",
