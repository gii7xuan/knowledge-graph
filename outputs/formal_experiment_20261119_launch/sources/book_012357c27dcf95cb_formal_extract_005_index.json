        },
        {
          "sentence_id": "sentence_e2e3713de908b1bdf219",
          "document_start": 529,
          "document_end": 553,
          "text": "非完整约束的约束方程一般形式如式（2-4）所示。",
          "section_id": "section_10527db36f2f",
