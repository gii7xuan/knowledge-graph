        },
        {
          "sentence_id": "sentence_36186002569d2b1642b8",
          "document_start": 752,
          "document_end": 778,
          "text": "工程中经常遇到的非完整约束，大多数是1阶非完整约束。",
          "section_id": "section_10527db36f2f",
          "start": 752,
