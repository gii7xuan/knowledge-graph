        },
        {
          "sentence_id": "sentence_fc747aa120a7eb6c2da6",
          "document_start": 511,
          "document_end": 529,
          "text": "非完整约束就是指不可积分的运动约束。",
          "section_id": "section_10527db36f2f",
          "start": 511,
          "end": 529,
          "chunk_start": 511,
          "chunk_end": 529,
          "sentence_document_start": 511,
