        {
          "sentence_id": "sentence_93e716947967b3c52a6e",
          "document_start": 489,
          "document_end": 511,
          "text": "如前述的刚性单摆和纯滚动车轮均属于完整约束。",
          "section_id": "section_10527db36f2f",
          "start": 489,
