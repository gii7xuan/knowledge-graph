          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_78d134e946b4bf60ced9",
          "document_start": 721,
          "document_end": 752,
          "text": "若方程式中含有2阶或高阶导数，那么这种约束称为高阶非完整约束。",
          "section_id": "section_10527db36f2f",
          "start": 721,
          "end": 752,
          "chunk_start": 721,
          "chunk_end": 752,
          "sentence_document_start": 721,
