          "section_id": "section_10527db36f2f",
          "start": 979,
          "end": 1011,
          "chunk_start": 979,
          "chunk_end": 1011,
          "sentence_document_start": 979,
          "sentence_document_end": 1011,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5a4b8ae1740ba593bd44",
          "document_start": 1013,
          "document_end": 1026,
          "text": "（4）单面约束和双面约束。",
          "section_id": "section_10527db36f2f",
          "start": 1013,
          "end": 1026,
          "chunk_start": 1013,
          "chunk_end": 1026,
          "sentence_document_start": 1013,
          "sentence_document_end": 1026,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b2be75ffeb868607854f",
          "document_start": 1026,
          "document_end": 1079,
          "text": "若质点系虽然受到约束，但在某些方向可以脱离约束的限制，则这类约束称为单面约束（又称可解约束、非固执约束）。",
          "section_id": "section_10527db36f2f",
          "start": 1026,
          "end": 1079,
          "chunk_start": 1026,
          "chunk_end": 1079,
          "sentence_document_start": 1026,
          "sentence_document_end": 1079,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_13aa2c77f4bc264b314f",
          "document_start": 1079,
          "document_end": 1091,
          "text": "单面约束方程的一般形式为",
          "section_id": "section_10527db36f2f",
          "start": 1079,
          "end": 1091,
          "chunk_start": 1079,
          "chunk_end": 1091,
          "sentence_document_start": 1079,
          "sentence_document_end": 1091,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_4a34e2712e0db25aa435",
          "document_start": 1093,
          "document_end": 1113,
          "text": "[Source paragraph 7;",
          "section_id": "section_10527db36f2f",
          "start": 1093,
          "end": 1113,
          "chunk_start": 1093,
          "chunk_end": 1113,
          "sentence_document_start": 1093,
          "sentence_document_end": 1113,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9ad86f44712a645c89c6",
          "document_start": 1114,
          "document_end": 1124,
          "text": "# 2）约束的分类;",
          "section_id": "section_10527db36f2f",
          "start": 1114,
          "end": 1124,
          "chunk_start": 1114,
          "chunk_end": 1124,
          "sentence_document_start": 1114,
          "sentence_document_end": 1124,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_cfff0f7906fa51a4ff47",
          "document_start": 1125,
          "document_end": 1157,
          "text": "intervening text may be omitted]",
          "section_id": "section_10527db36f2f",
          "start": 1125,
          "end": 1157,
          "chunk_start": 1125,
          "chunk_end": 1157,
          "sentence_document_start": 1125,
          "sentence_document_end": 1157,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_aefd0836546edd249a1c",
          "document_start": 1159,
          "document_end": 1193,
          "text": "单面约束的力学问题，一般都可以分为双面约束和自由系统两种情况来处理。",
          "section_id": "section_10527db36f2f",
          "start": 1159,
          "end": 1193,
          "chunk_start": 1159,
          "chunk_end": 1193,
          "sentence_document_start": 1159,
          "sentence_document_end": 1193,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_8e93288cbc6ccfdb6538",
          "document_start": 1193,
          "document_end": 1217,
          "text": "当系统在约束面上运动时，按双面约束情况进行研究；",
          "section_id": "section_10527db36f2f",
          "start": 1193,
          "end": 1217,
          "chunk_start": 1193,
          "chunk_end": 1217,
          "sentence_document_start": 1193,
          "sentence_document_end": 1217,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_15000b11a5ae1eb86280",
          "document_start": 1217,
          "document_end": 1252,
          "text": "一旦系统脱离了约束的界面，则把脱离约束界面以后的运动当作自由运动处理。",
          "section_id": "section_10527db36f2f",
          "start": 1217,
          "end": 1252,
          "chunk_start": 1217,
          "chunk_end": 1252,
          "sentence_document_start": 1217,
          "sentence_document_end": 1252,
          "sentence_complete": true
        }
      ],
