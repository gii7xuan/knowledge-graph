          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5198729ee609be00eeff",
          "document_start": 277,
          "document_end": 346,
          "text": "任何流体运动的规律都是以质量守恒、动量守恒和能量守恒定律为基础的，这些基本定律可由数学方程组来描述，体现为连续性方程、动量方程和能量方程。",
          "section_id": "section_a21ef50e1574",
          "start": 277,
          "end": 346,
          "chunk_start": 277,
          "chunk_end": 346,
          "sentence_document_start": 277,
          "sentence_document_end": 346,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_db09d510e336ccc312e0",
          "document_start": 348,
          "document_end": 368,
          "text": "[Source paragraph 3;",
          "section_id": "section_a21ef50e1574",
