          "chunk_end": 716,
          "sentence_document_start": 712,
          "sentence_document_end": 716,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_ba59337bb2e7bc948731",
          "document_start": 717,
          "document_end": 749,
          "text": "intervening text may be omitted]",
          "section_id": "section_d3ec99cb7d89",
          "start": 717,
          "end": 749,
          "chunk_start": 717,
          "chunk_end": 749,
          "sentence_document_start": 717,
          "sentence_document_end": 749,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_848c5c080c86deee99a0",
          "document_start": 751,
          "document_end": 774,
          "text": "该高低机主要由一对齿轮副和一对蜗杆蜗轮副组成。",
          "section_id": "section_d3ec99cb7d89",
          "start": 751,
          "end": 774,
          "chunk_start": 751,
          "chunk_end": 774,
          "sentence_document_start": 751,
          "sentence_document_end": 774,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e2dcc184b3e41a780ecc",
          "document_start": 774,
          "document_end": 847,
          "text": "齿轮传动副由高低齿弧、高低机齿轮和高低机齿轮轴组成，高低齿弧装在摇架上，高低机齿轮安装在高低机齿轮轴的右端，高低机齿轮轴由高低机箱的两个衬筒固定。",
          "section_id": "section_d3ec99cb7d89",
          "start": 774,
          "end": 847,
          "chunk_start": 774,
          "chunk_end": 847,
          "sentence_document_start": 774,
          "sentence_document_end": 847,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_60e18304c424a948f023",
          "document_start": 847,
          "document_end": 865,
          "text": "高低机齿轮轴上有花键，用来安装蜗轮。",
          "section_id": "section_d3ec99cb7d89",
          "start": 847,
          "end": 865,
          "chunk_start": 847,
          "chunk_end": 865,
          "sentence_document_start": 847,
          "sentence_document_end": 865,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_a0f88a7a653167189c00",
          "document_start": 865,
          "document_end": 906,
          "text": "蜗杆蜗轮副由蜗杆和蜗轮组成，蜗杆与高低机手轮相连，蜗轮用花键安装在高低机齿轮轴上。",
          "section_id": "section_d3ec99cb7d89",
          "start": 865,
          "end": 906,
          "chunk_start": 865,
          "chunk_end": 906,
          "sentence_document_start": 865,
          "sentence_document_end": 906,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b63dfc4d48f86d150e23",
          "document_start": 906,
          "document_end": 987,
          "text": "为了转动灵活，蜗杆轴前部装滚针轴承，并用带毡环（防尘）的螺帽固定，后部套有滚针轴承和双向止推轴承，以确定蜗杆的轴向位置，并在转动高低机时减小蜗杆所受的轴向摩擦力。",
          "section_id": "section_d3ec99cb7d89",
          "start": 906,
          "end": 987,
          "chunk_start": 906,
          "chunk_end": 987,
          "sentence_document_start": 906,
          "sentence_document_end": 987,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b4c0a65884cf65981a75",
          "document_start": 987,
          "document_end": 1040,
          "text": "蜗轮由钢制的轮毂和铜制的轮圈组成，并用铆钉相连接，采用铜制轮圈的优点是可以减小摩擦、提高蜗轮的抗磨损性能。",
          "section_id": "section_d3ec99cb7d89",
          "start": 987,
          "end": 1040,
          "chunk_start": 987,
          "chunk_end": 1040,
          "sentence_document_start": 987,
          "sentence_document_end": 1040,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_29e953e4fd02053bb1a1",
          "document_start": 1042,
          "document_end": 1062,
          "text": "[Source paragraph 5;",
          "section_id": "section_d3ec99cb7d89",
          "start": 1042,
          "end": 1062,
          "chunk_start": 1042,
          "chunk_end": 1062,
          "sentence_document_start": 1042,
          "sentence_document_end": 1062,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c8914393657c9c22c053",
          "document_start": 1063,
          "document_end": 1067,
          "text": "# 2.",
          "section_id": "section_d3ec99cb7d89",
          "start": 1063,
          "end": 1067,
          "chunk_start": 1063,
          "chunk_end": 1067,
          "sentence_document_start": 1063,
          "sentence_document_end": 1067,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_4d0fbd52ac3c38b80eba",
          "document_start": 1068,
          "document_end": 1072,
          "text": "方向机;",
          "section_id": "section_d3ec99cb7d89",
          "start": 1068,
          "end": 1072,
          "chunk_start": 1068,
          "chunk_end": 1072,
          "sentence_document_start": 1068,
          "sentence_document_end": 1072,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_266a206b4878cfde4644",
          "document_start": 1073,
          "document_end": 1105,
          "text": "intervening text may be omitted]",
          "section_id": "section_d3ec99cb7d89",
          "start": 1073,
          "end": 1105,
          "chunk_start": 1073,
          "chunk_end": 1105,
          "sentence_document_start": 1073,
          "sentence_document_end": 1105,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_6e7e1a6677c3469e53d7",
          "document_start": 1107,
          "document_end": 1144,
          "text": "当两支点间的距离增大，螺筒推动回转部分转动时，前止推轴承起减小摩擦的作用；",
          "section_id": "section_d3ec99cb7d89",
          "start": 1107,
          "end": 1144,
          "chunk_start": 1107,
          "chunk_end": 1144,
          "sentence_document_start": 1107,
          "sentence_document_end": 1144,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_a6dee808a9be4aad4acc",
          "document_start": 1144,
          "document_end": 1176,
          "text": "当距离缩小，螺筒拉动回转部分转动时，后止推轴承起减小摩擦的作用。",
          "section_id": "section_d3ec99cb7d89",
          "start": 1144,
          "end": 1176,
          "chunk_start": 1144,
          "chunk_end": 1176,
          "sentence_document_start": 1144,
          "sentence_document_end": 1176,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_3dd89ab7049002c350ca",
          "document_start": 1178,
          "document_end": 1198,
          "text": "[Source paragraph 6;",
          "section_id": "section_d3ec99cb7d89",
          "start": 1178,
          "end": 1198,
          "chunk_start": 1178,
          "chunk_end": 1198,
          "sentence_document_start": 1178,
          "sentence_document_end": 1198,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_b4312b029c9753c8ba43",
          "document_start": 1199,
          "document_end": 1203,
          "text": "# 2.",
          "section_id": "section_d3ec99cb7d89",
          "start": 1199,
          "end": 1203,
          "chunk_start": 1199,
          "chunk_end": 1203,
          "sentence_document_start": 1199,
