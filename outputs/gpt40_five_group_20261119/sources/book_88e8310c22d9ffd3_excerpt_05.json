        },
        {
          "sentence_id": "sentence_2c1294d4819b777c92c5",
          "document_start": 2638,
          "document_end": 2727,
          "text": "These equations have been repeated here because of their critical importance to our work.",
          "section_id": "section_25a076b80a6b",
