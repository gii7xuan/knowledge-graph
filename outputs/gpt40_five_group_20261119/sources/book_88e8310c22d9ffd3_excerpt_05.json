    },
    {
      "sentence_id": "sentence_4d6f65dae5587d1cecad",
      "document_start": 1661,
      "document_end": 1859,
      "text": "If more inlets or outlets in our CV were present and they had different mass flow rates or pressures, we would have to consider each with a term identical to our outlet or inlet terms given earlier.",
      "section_id": "section_25a076b80a6b"
    },
    {
      "sentence_id": "sentence_1d7aaddfa530a6692c4e",
      "document_start": 1860,
      "document_end": 1922,
      "text": "We now can make the substitution for our energy terms to yield",
