          "document_end": 242,
          "text": "intervening text may be omitted]",
          "section_id": "section_531323ea0ef7",
          "start": 210,
          "end": 242,
          "chunk_start": 210,
          "chunk_end": 242,
          "sentence_document_start": 210,
          "sentence_document_end": 242,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5d2d4ad47610f93b11eb",
          "document_start": 244,
          "document_end": 274,
          "text": "如果流动满足：i 流动是定常的（各参量对时间的偏导数为零）；",
          "section_id": "section_531323ea0ef7",
          "start": 244,
          "end": 274,
          "chunk_start": 244,
          "chunk_end": 274,
          "sentence_document_start": 244,
          "sentence_document_end": 274,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_1b3f36a963f9b148a3b1",
          "document_start": 274,
          "document_end": 285,
          "text": "ii 质量力是有势力；",
          "section_id": "section_531323ea0ef7",
          "start": 274,
          "end": 285,
          "chunk_start": 274,
          "chunk_end": 285,
          "sentence_document_start": 274,
          "sentence_document_end": 285,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f1c132e67b41b26a0122",
          "document_start": 285,
          "document_end": 338,
          "text": "iii 流体是正压性的（密度可以只表示为压力的函数）或不可压缩，则可以将欧拉运动微分方程沿着流线积分，得：",
          "section_id": "section_531323ea0ef7",
          "start": 285,
          "end": 338,
          "chunk_start": 285,
          "chunk_end": 338,
          "sentence_document_start": 285,
          "sentence_document_end": 338,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_40a5ab6642e89345f598",
          "document_start": 340,
          "document_end": 360,
          "text": "[Source paragraph 3;",
          "section_id": "section_531323ea0ef7",
          "start": 340,
          "end": 360,
          "chunk_start": 340,
          "chunk_end": 360,
          "sentence_document_start": 340,
          "sentence_document_end": 360,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2a1328e622f630f8100a",
          "document_start": 361,
          "document_end": 380,
          "text": "3.2.3 运动微分方程与伯努利方程;",
          "section_id": "section_531323ea0ef7",
          "start": 361,
          "end": 380,
          "chunk_start": 361,
          "chunk_end": 380,
          "sentence_document_start": 361,
          "sentence_document_end": 380,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_f536bdb56eba434c165e",
          "document_start": 381,
          "document_end": 413,
          "text": "intervening text may be omitted]",
          "section_id": "section_531323ea0ef7",
          "start": 381,
          "end": 413,
          "chunk_start": 381,
          "chunk_end": 413,
          "sentence_document_start": 381,
          "sentence_document_end": 413,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_ef96f374ab2400479102",
          "document_start": 415,
          "document_end": 427,
          "text": "这就是著名的伯努利方程。",
          "section_id": "section_531323ea0ef7",
          "start": 415,
          "end": 427,
          "chunk_start": 415,
          "chunk_end": 427,
          "sentence_document_start": 415,
          "sentence_document_end": 427,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_9e452ceb6c8cad7e3520",
          "document_start": 427,
          "document_end": 456,
          "text": "方程中的三项依次为单位质量流体的重力势能、动能和压力势能。",
          "section_id": "section_531323ea0ef7",
          "start": 427,
          "end": 456,
          "chunk_start": 427,
          "chunk_end": 456,
          "sentence_document_start": 427,
          "sentence_document_end": 456,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_e2728ebe831fc52dc438",
          "document_start": 456,
          "document_end": 507,
          "text": "伯努利方程表明，当流动满足上述一系列条件时，在同一条流线上，重力势能、动能与压力势能之总和保持为常数。",
          "section_id": "section_531323ea0ef7",
          "start": 456,
          "end": 507,
          "chunk_start": 456,
          "chunk_end": 507,
          "sentence_document_start": 456,
          "sentence_document_end": 507,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_c61c9b4c92c81c52d29e",
          "document_start": 507,
          "document_end": 529,
          "text": "伯努利方程反映了理想流体流动中的机械能守恒。",
          "section_id": "section_531323ea0ef7",
          "start": 507,
          "end": 529,
          "chunk_start": 507,
          "chunk_end": 529,
          "sentence_document_start": 507,
          "sentence_document_end": 529,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_400e07dc044a6a2d1855",
          "document_start": 531,
          "document_end": 551,
          "text": "[Source paragraph 4;",
          "section_id": "section_531323ea0ef7",
          "start": 531,
          "end": 551,
          "chunk_start": 531,
          "chunk_end": 551,
          "sentence_document_start": 531,
          "sentence_document_end": 551,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_01a10973337023f5e784",
          "document_start": 552,
          "document_end": 571,
          "text": "3.2.3 运动微分方程与伯努利方程;",
          "section_id": "section_531323ea0ef7",
          "start": 552,
          "end": 571,
          "chunk_start": 552,
          "chunk_end": 571,
          "sentence_document_start": 552,
          "sentence_document_end": 571,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_08f420c121c93248ca35",
          "document_start": 572,
          "document_end": 604,
          "text": "intervening text may be omitted]",
          "section_id": "section_531323ea0ef7",
          "start": 572,
          "end": 604,
          "chunk_start": 572,
          "chunk_end": 604,
          "sentence_document_start": 572,
          "sentence_document_end": 604,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2936fb28fdf8b69d7231",
          "document_start": 606,
          "document_end": 632,
          "text": "实际流体由于存在黏性，在流动会有机械能向热能的转换。",
          "section_id": "section_531323ea0ef7",
          "start": 606,
          "end": 632,
          "chunk_start": 606,
          "chunk_end": 632,
          "sentence_document_start": 606,
          "sentence_document_end": 632,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_2c2ca5d0a8d6bac57c8e",
          "document_start": 632,
          "document_end": 664,
          "text": "也就是说，在实际流体的流动中有机械能的损失，不符合式(3.9)。",
          "section_id": "section_531323ea0ef7",
          "start": 632,
          "end": 664,
          "chunk_start": 632,
          "chunk_end": 664,
          "sentence_document_start": 632,
          "sentence_document_end": 664,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_3af6ac7686aa62e63fba",
          "document_start": 666,
          "document_end": 686,
          "text": "[Source paragraph 5;",
          "section_id": "section_531323ea0ef7",
          "start": 666,
          "end": 686,
          "chunk_start": 666,
          "chunk_end": 686,
          "sentence_document_start": 666,
          "sentence_document_end": 686,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_47558076751c8340563d",
          "document_start": 687,
          "document_end": 706,
          "text": "3.2.3 运动微分方程与伯努利方程;",
          "section_id": "section_531323ea0ef7",
          "start": 687,
          "end": 706,
          "chunk_start": 687,
          "chunk_end": 706,
          "sentence_document_start": 687,
          "sentence_document_end": 706,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_47327b69a9271b01cd8e",
          "document_start": 707,
          "document_end": 739,
          "text": "intervening text may be omitted]",
          "section_id": "section_531323ea0ef7",
          "start": 707,
          "end": 739,
          "chunk_start": 707,
          "chunk_end": 739,
          "sentence_document_start": 707,
          "sentence_document_end": 739,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_1c65a0d0dd4c2e96c515",
          "document_start": 741,
          "document_end": 792,
          "text": "对于有限过流截面的实际流体管流，将式(3.10)在管道截面上积分平均，即得到实际流体管流的伯努利方程：",
          "section_id": "section_531323ea0ef7",
          "start": 741,
          "end": 792,
          "chunk_start": 741,
          "chunk_end": 792,
          "sentence_document_start": 741,
          "sentence_document_end": 792,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_0d65e9e8402185499545",
          "document_start": 794,
          "document_end": 814,
          "text": "[Source paragraph 6;",
          "section_id": "section_531323ea0ef7",
          "start": 794,
          "end": 814,
          "chunk_start": 794,
          "chunk_end": 814,
          "sentence_document_start": 794,
          "sentence_document_end": 814,
          "sentence_complete": true
        },
        {
          "sentence_id": "sentence_5194129025c5a4526d27",
          "document_start": 815,
          "document_end": 834,
          "text": "3.2.3 运动微分方程与伯努利方程;",
          "section_id": "section_531323ea0ef7",
