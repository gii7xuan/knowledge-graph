      "lexical_relevance_score": 0,
      "offset_basis": "canonical_document",
      "query_purpose": "check_support",
      "quote": "大口径高初速的火炮，一方面弹道系数小，另一方面其最大弹道高  $H$  高，弹丸可以很快穿过稠密大气层而到达空气稀薄的高空（ $y > 15~\\mathrm{km}$ ， $H(y)\\leqslant 0.16$ ），此时弹道倾角如果接近  $45^{\\circ}$ ，在该层飞行最远，这样在地面的射角必然大于  $45^{\\circ}$ ，因而  $\\theta_{0X\\mathrm{m}}$  远比  $45^{\\circ}$  大，一般为  $50^{\\circ} \\sim 55^{\\circ}$ 。",
      "retrieval_level": "current_chunk",
      "retrieval_score": 0.78,
      "retrieved_via_levels": [
        "current_chunk"
      ],
      "review_obligation": false,
