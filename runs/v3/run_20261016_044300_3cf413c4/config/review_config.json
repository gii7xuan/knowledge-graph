  "planner": {
    "enabled": true,
    "strategy": "deterministic",
    "model_env": "KG_PLANNER_MODEL",
    "api_key_env": "<redacted>",
    "base_url_env": "KG_PLANNER_BASE_URL"
  },
  "validators": [
    {
      "id": "judge_a",
      "model_env": "KG_JUDGE_A_MODEL",
      "family_env": "KG_JUDGE_A_FAMILY",
      "api_key_env": "<redacted>",
      "base_url_env": "KG_JUDGE_A_BASE_URL"
    },
    {
      "id": "judge_b",
      "model_env": "KG_JUDGE_B_MODEL",
      "family_env": "KG_JUDGE_B_FAMILY",
      "api_key_env": "<redacted>",
      "base_url_env": "KG_JUDGE_B_BASE_URL"
    },
    {
      "id": "judge_c",
      "model_env": "KG_JUDGE_C_MODEL",
      "family_env": "KG_JUDGE_C_FAMILY",
      "api_key_env": "<redacted>",
      "base_url_env": "KG_JUDGE_C_BASE_URL"
    },
    {
      "id": "judge_d",
      "model_env": "KG_JUDGE_D_MODEL",
      "family_env": "KG_JUDGE_D_FAMILY",
      "api_key_env": "<redacted>",
      "base_url_env": "KG_JUDGE_D_BASE_URL"
    }
  ],
  "consensus": {
