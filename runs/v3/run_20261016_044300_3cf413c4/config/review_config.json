  "calibration": {
    "enabled": true,
    "feature_schema_version": "review_features_v3",
    "model_path": null,
    "policy_path": null,
    "target_precision": 0.95,
    "min_policy_selected": 100
  },
  "routing": {
    "auto_accept_enabled": false,
    "semantic_auto_reject_enabled": false,
    "random_audit_fraction": 0.05
  },
  "memory": {
    "enabled": true,
    "max_positive_cases": 3,
    "max_negative_cases": 3,
    "snapshot_policy": "freeze_per_audit"
  },
  "neo4j": {
    "auto_import_enabled": false,
    "require_current_decision": true
  }
